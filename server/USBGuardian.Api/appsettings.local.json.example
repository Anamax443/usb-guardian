{
  // ============================================================
  // appsettings.local.json – PŘÍKLAD lokálního přepisu
  // Zkopírujte jako appsettings.local.json a upravte
  // Tento soubor se NECOMMITUJE (.gitignore)
  // ============================================================

  "ConnectionStrings": {
    "DefaultConnection": "Server=SQL_SERVER;Database=USBGuardian;Integrated Security=true;TrustServerCertificate=true;"
  },

  "Authorization": {
    // Cteni (heartbeat, stazeni whitelistu) - ucty stanic + admini.
    "AllowedGroups": [
      "DOMENA\\USB-Guardian-Clients",
      "DOMENA\\IT-Admins"
    ],
    // Zapis (POST /api/whitelist/devices) - jen admini. Prazdne = nikdo (fail-closed).
    "AdminGroups": [
      "DOMENA\\IT-Admins"
    ]
  }
}
