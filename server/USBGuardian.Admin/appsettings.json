{
  "ConnectionStrings": {
    "DefaultConnection": "Server=tcp:YOUR_SQL_SERVER,1433;Database=USBGuardian;Integrated Security=true;TrustServerCertificate=true;"
  },

  "Authorization": {
    "AdminGroups": [ "DOMENA\\USB-Guardian-Admins" ],
    "DevAllowAll": false
  },

  "AdSync": {
    "Enabled": false,
    "IntervalMinutes": 60,
    "SearchBase": "",
