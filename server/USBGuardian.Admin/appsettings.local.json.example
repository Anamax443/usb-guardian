{
  // ============================================================
  // appsettings.local.json — JEDINÉ místo s firemně specifickými
  // hodnotami. Zkopíruj na 'appsettings.local.json' a uprav.
  // Soubor je gitignored (*.local.json).
  // ============================================================

  "ConnectionStrings": {
    // SQL Server s databází USBGuardian (Windows auth / gMSA)
    "DefaultConnection": "Server=tcp:SQL-SERVER,1433;Database=USBGuardian;Integrated Security=true;TrustServerCertificate=true;"
  },

  "Authorization": {
    // AD skupiny s přístupem do konzole (formát "DOMENA\\Skupina")
    "AdminGroups": [ "DOMENA\\USB-Guardian-Admins" ],
    // Volitelně konkrétní účty navíc (whitelist)
    "AllowedUsers": [ "DOMENA\\jmeno.admina" ],
    // true POUZE pro lokální vývoj – v produkci VŽDY false
    "DevAllowAll": false
  },

  "Kestrel": {
    // Port konzole (0.0.0.0 = dostupné na síti)
    "Endpoints": { "Http": { "Url": "http://0.0.0.0:4200" } }
  },

  "AdSync": {
    "Enabled": true,            // časovač AD syncu
    "IntervalMinutes": 60,
    "SearchBase": "",           // prázdné = celá doména serveru; jinak DN konkrétní OU
    "IncludeDisabled": false    // zahrnout i disabled účty počítačů
  },

  // Odkaz na repozitář – commit v patičce je klikací na /commit/<sha>. Prázdné = neklikací.
  "RepoUrl": "https://github.com/Anamax443/usb-guardian"
}
