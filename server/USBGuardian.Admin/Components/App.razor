@inject USBGuardian.Admin.Ui.UiStyleCache Ui
@inject IHttpContextAccessor Http
<!DOCTYPE html>
@* Motiv vykresluje SERVER z cookie. Dřív ho nastavoval až skript v prohlížeči
   z localStorage — jenže Blazor při překliknutí (enhanced navigation) přepíše
   atributy <html> podle serverové odpovědi, a protože ta o motivu nevěděla,
   volba po každém překliku zmizela a vzhled skočil zpátky na systémový.
   Cookie chodí s každým požadavkem, takže atribut sedí hned a nikde neprobliká.
   Prázdná hodnota = žádná volba → rozhoduje nastavení systému. *@
<html lang="cs" data-theme="@Theme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />

    @* Banka UI (repo Anamax443/Interface-Par): písma → tokeny VYBRANÉHO stylu → vrstva komponent.
       Pořadí je závazné. Styl se přepíná v Nastavení, hodnota projde whitelistem v UiStyleCache.
       ?v=<commit> je nutnost, ne kosmetika: statické soubory jdou bez Cache-Control, takže
       prohlížeč po redeployi držel STAROU app.css a stránka se míchala ze dvou verzí. *@
    <link rel="stylesheet" href="@($"bank/fonts.css?v={AppInfo.Commit}")" />
    <link rel="stylesheet" href="@($"bank/tokens/style/{Ui.Style}.css?v={AppInfo.Commit}")" />
    <link rel="stylesheet" href="@($"bank/ui.css?v={AppInfo.Commit}")" />

    @* Vlastní vrstva konzole – komponenty této aplikace, výhradně přes role banky. *@
    <link rel="stylesheet" href="@($"app.css?v={AppInfo.Commit}")" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%23161b22'/><path d='M16 4l9 3.2v6.3c0 6.4-3.8 10.8-9 13.5-5.2-2.7-9-7.1-9-13.5V7.2z' fill='%2358a6ff'/><rect x='14.6' y='10' width='2.8' height='9' rx='1' fill='%23161b22'/><circle cx='16' cy='9' r='2' fill='%23161b22'/></svg>" />
    <title>USB Guardian — konzole</title>
    <HeadOutlet />
</head>
<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
</body>
</html>

@code {
    private const string ThemeCookie = "axima.theme";

    /// <summary>"dark" / "light" z cookie; prázdné = žádná volba → platí nastavení systému.</summary>
    private string Theme
    {
        get
        {
            var v = Http.HttpContext?.Request.Cookies[ThemeCookie];
            return v is "dark" or "light" ? v : "";
        }
    }
}
