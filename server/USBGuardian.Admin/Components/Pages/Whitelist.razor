@page "/whitelist"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IConfiguration Config

<h1>Whitelist — schválená média</h1>

<p class="intro">Stačí zadat <strong>sériové číslo</strong> — i dopředu, než se médium poprvé připojí.
VID/PID a název si konzole <strong>dotáhne sama</strong>, jakmile se médium objeví na síti.
Položka jde kdykoli <strong>dočasně deaktivovat</strong> (checkbox „Aktivní") bez mazání.</p>

@if (_error is not null)
{
    <div class="banner bad">Chyba databáze: @_error</div>
}
else
{
    <div class="cards">
        <div class="card"><div class="num">@_active</div><div class="lbl">Aktivních (schválených)</div></div>
        <div class="card @(_disabled > 0 ? "warn" : "")"><div class="num">@_disabled</div><div class="lbl">Deaktivovaných</div></div>
        <div class="card"><div class="num mono">@(_ver?.Version ?? "—")</div><div class="lbl">Aktivní verze</div></div>
        <div class="card @(_signed ? "" : "warn")"><div class="num">@(_signed ? "podepsáno" : "—")</div><div class="lbl">Stav podpisu</div></div>
    </div>

    <h2>Publikace verze — podepsaný whitelist pro agenty (1:1 kopie na klienta)</h2>
    <p class="muted">Agenti dostávají <strong>jen podepsanou</strong> verzi (privátní klíč nikdy na serveru).
        Postup: ① <strong>Vydat verzi</strong> z katalogu → ② <strong>stáhnout</strong> <code>whitelist.json</code> →
        ③ offline podepsat (<code>WhitelistSigner sign whitelist.json</code>) → ④ <strong>nahrát</strong> <code>.sig</code> → aktivace.
        Po aktivaci si ji agenti stáhnou do ~2 min (heartbeat).</p>
    <div class="toolbar">
        <button class="btn" @onclick="PublishVersion" disabled="@_busy">① Vydat verzi z katalogu (@_active aktivních)</button>
        @if (_pending is not null)
        {
            <a class="btn" href="/whitelist/pending.json" target="_blank" rel="noopener">② Stáhnout whitelist.json</a>
        }
    </div>
    @if (_pending is not null)
    {
        <div class="banner warn">Verze <strong>@_pending.Version</strong> čeká na podpis
            (vydáno @_pending.IssuedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm"), @_pendingCount zařízení).
            Podepiš offline a nahraj <code>.sig</code>:</div>
        <div class="toolbar">
            <label class="btn">④ Nahrát .sig <InputFile OnChange="OnSigSelected" accept=".sig,.txt" style="display:none" /></label>
            @if (_sigMsg is not null) { <span class="muted">@_sigMsg</span> }
        </div>
    }
    @if (_pubMsg is not null) { <div class="banner @(_pubBad ? "bad" : "ok")">@_pubMsg</div> }

    <h2>Přidat médium</h2>
    <div class="toolbar">
        <input class="inp mono" @bind="_serial" placeholder="sériové číslo" @onkeydown="OnKey" />
        <button class="btn" @onclick="AddOne" disabled="@_busy">Přidat</button>
    </div>

    <details class="import">
        <summary>Hromadný import (sériová čísla, jedno na řádek)</summary>
        <textarea class="ta mono" @bind="_bulk" rows="5" placeholder="4B018CD154C9&#10;A1B2C3D4E5F6"></textarea>
        <div><button class="btn" @onclick="ImportBulk" disabled="@_busy">Importovat</button></div>
    </details>

    @if (_msg is not null)
    {
        <div class="banner @(_msgBad ? "bad" : "ok")">@_msg</div>
    }

    <h2>Katalog (@_devices.Count)</h2>
    @if (_devices.Count == 0)
    {
        <p class="muted">Zatím žádné médium.</p>
    }
    else
    {
        <table>
            <thead>
                <tr><th>VID</th><th>PID</th><th>Sériové číslo</th><th>Kapacita</th><th>Popis</th><th>Schválil</th><th>Aktivní</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var d in _devices)
                {
                    if (_editId == d.Id)
                    {
                        <tr>
                            <td><input class="inp mono" style="min-width:90px" @bind="_eVid" /></td>
                            <td><input class="inp mono" style="min-width:130px" @bind="_ePid" /></td>
                            <td><input class="inp mono" style="min-width:120px" @bind="_eSerial" /></td>
                            <td class="muted">@FormatSize(SizeOf(d.SerialNumber))</td>
                            <td><input class="inp" @bind="_eDesc" /></td>
                            <td class="muted">@d.ApprovedBy</td>
                            <td>—</td>
                            <td>
                                <button class="iconbtn" @onclick="SaveEdit" disabled="@_busy" title="Uložit">✔</button>
                                <button class="iconbtn" @onclick="CancelEdit" title="Zrušit">✕</button>
                            </td>
                        </tr>
                    }
                    else
                    {
                        <tr class="@(d.IsActive ? "" : "rowoff")">
                            <td class="mono">@(string.IsNullOrEmpty(d.VendorId) ? "—" : d.VendorId)</td>
                            <td class="mono">@(string.IsNullOrEmpty(d.ProductId) ? "—" : d.ProductId)</td>
                            <td class="mono">@(string.IsNullOrEmpty(d.SerialNumber) ? "—" : d.SerialNumber)</td>
                            <td class="muted">@FormatSize(SizeOf(d.SerialNumber))</td>
                            <td>
                                @(string.IsNullOrEmpty(d.Description) ? "—" : d.Description)
                                @if (string.IsNullOrEmpty(d.VendorId)) { <span class="pill warn">čeká na výskyt</span> }
                            </td>
                            <td class="muted">@d.ApprovedBy</td>
                            <td>
                                <input type="checkbox" checked="@d.IsActive" @onchange="() => ToggleActive(d)" disabled="@_busy"
                                       title="@(d.IsActive ? "Deaktivovat (zakázat)" : "Aktivovat (schválit)")" />
                            </td>
                            <td>
                                <button class="iconbtn" @onclick="() => StartEdit(d)" title="Upravit">✎</button>
                                <button class="iconbtn" @onclick="() => Remove(d.Id)" title="Smazat">✕</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        <p class="muted" data-no-print>Změny v katalogu se k agentům dostanou po vydání nové <strong>podepsané</strong>
        verze whitelistu (podpisový workflow — privátní klíč nikdy na serveru).</p>
    }
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private string? _error, _msg;
    private bool _msgBad, _busy;
    private string _serial = "";
    private string _bulk = "";
    private string _user = "konzole";

    private List<WhitelistDevice> _devices = new();
    private WhitelistVersion? _ver;
    private bool _signed;
    private int _active, _disabled;

    // Publikace: verze čekající na podpis (IsActive=false, Signature='', Json<>'')
    private WhitelistVersion? _pending;
    private int _pendingCount;
    private string? _pubMsg, _sigMsg;
    private bool _pubBad;

    // Kapacita média se na whitelistu nedrží – dotahuje se z incidentů (max SizeBytes podle sériáku).
    private Dictionary<string, long> _sizes = new(StringComparer.OrdinalIgnoreCase);
    private long SizeOf(string serial) =>
        !string.IsNullOrWhiteSpace(serial) && _sizes.TryGetValue(serial.Trim(), out var s) ? s : 0;
    private static string FormatSize(long bytes) => bytes > 0 ? $"{bytes / 1_073_741_824.0:F1} GB" : "—";

    private int? _editId;
    private string _eVid = "", _ePid = "", _eSerial = "", _eDesc = "";

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var u = (await AuthState).User.Identity?.Name;
            if (!string.IsNullOrEmpty(u)) _user = u;
        }
        await Load();
    }

    private async Task Load()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await Backfill(db);

            _devices  = await db.WhitelistDevices.OrderByDescending(d => d.ApprovedAt).ToListAsync();

            // kapacity z incidentů (max podle sériáku) – jen pro sériová čísla v katalogu
            var serials = _devices.Where(d => !string.IsNullOrEmpty(d.SerialNumber))
                .Select(d => d.SerialNumber).Distinct().ToList();
            _sizes = (await db.Incidents
                    .Where(i => serials.Contains(i.SerialNumber) && i.SizeBytes > 0)
                    .GroupBy(i => i.SerialNumber)
                    .Select(g => new { Serial = g.Key, Size = g.Max(i => i.SizeBytes) })
                    .ToListAsync())
                .ToDictionary(x => x.Serial, x => x.Size, StringComparer.OrdinalIgnoreCase);

            _ver      = await db.WhitelistVersions.Where(v => v.IsActive)
                .OrderByDescending(v => v.IssuedAt).FirstOrDefaultAsync();
            _signed   = _ver != null && !string.IsNullOrWhiteSpace(_ver.Signature);
            _active   = _devices.Count(d => d.IsActive);
            _disabled = _devices.Count(d => !d.IsActive);

            _pending = await db.WhitelistVersions
                .Where(v => !v.IsActive && v.Signature == "" && v.Json != "")
                .OrderByDescending(v => v.IssuedAt).FirstOrDefaultAsync();
            _pendingCount = 0;
            if (_pending != null)
            {
                try
                {
                    using var doc = System.Text.Json.JsonDocument.Parse(_pending.Json);
                    if (doc.RootElement.TryGetProperty("devices", out var dev) && dev.ValueKind == System.Text.Json.JsonValueKind.Array)
                        _pendingCount = dev.GetArrayLength();
                }
                catch { }
            }
            _error = null;
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private static async Task Backfill(AppDbContext db)
    {
        var need = await db.WhitelistDevices.Where(d => d.VendorId == "" && d.SerialNumber != "").ToListAsync();
        if (need.Count == 0) return;
        var changed = false;
        foreach (var d in need)
        {
            var inc = await db.Incidents.Where(i => i.SerialNumber == d.SerialNumber && i.VendorId != "")
                .OrderByDescending(i => i.Timestamp).FirstOrDefaultAsync();
            if (inc is null) continue;
            d.VendorId = inc.VendorId; d.ProductId = inc.ProductId;
            if (string.IsNullOrEmpty(d.Description)) d.Description = inc.FriendlyName;
            changed = true;
        }
        if (changed) await db.SaveChangesAsync();
    }

    private async Task OnKey(KeyboardEventArgs e) { if (e.Key == "Enter") await AddOne(); }

    private async Task AddOne()
    {
        _msg = null;
        var serial = (_serial ?? "").Trim();
        if (serial.Length == 0) { Msg("Zadej sériové číslo.", true); return; }
        _busy = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            if (await db.WhitelistDevices.AnyAsync(d => d.SerialNumber == serial))
            { Msg($"{serial} už je v katalogu.", true); return; }

            var inc = await db.Incidents.Where(i => i.SerialNumber == serial && i.VendorId != "")
                .OrderByDescending(i => i.Timestamp).FirstOrDefaultAsync();

            db.WhitelistDevices.Add(new WhitelistDevice
            {
                VendorId = inc?.VendorId ?? "", ProductId = inc?.ProductId ?? "", SerialNumber = serial,
                Description = inc?.FriendlyName ?? "", ApprovedBy = _user, ApprovedAt = DateTime.UtcNow,
                IsActive = true
            });
            await db.SaveChangesAsync();
            _serial = "";
            Msg(inc != null
                ? $"Přidáno a aktivní: {inc.VendorId}:{inc.ProductId}:{serial} — {inc.FriendlyName}"
                : $"Přidáno a aktivní: {serial} — VID/PID se dotáhnou, až se médium objeví na síti", false);
            await Load();
        }
        catch (Exception ex) { Msg("Chyba: " + ex.Message, true); }
        finally { _busy = false; }
    }

    private async Task ImportBulk()
    {
        var serials = (_bulk ?? "")
            .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(s => s.Trim()).Where(s => s.Length > 0).Distinct().ToList();
        if (serials.Count == 0) { Msg("Vlož sériová čísla (jedno na řádek).", true); return; }
        _busy = true;
        int added = 0, dup = 0;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            foreach (var serial in serials)
            {
                if (await db.WhitelistDevices.AnyAsync(d => d.SerialNumber == serial)) { dup++; continue; }
                var inc = await db.Incidents.Where(i => i.SerialNumber == serial && i.VendorId != "")
                    .OrderByDescending(i => i.Timestamp).FirstOrDefaultAsync();
                db.WhitelistDevices.Add(new WhitelistDevice
                {
                    VendorId = inc?.VendorId ?? "", ProductId = inc?.ProductId ?? "", SerialNumber = serial,
                    Description = inc?.FriendlyName ?? "", ApprovedBy = _user, ApprovedAt = DateTime.UtcNow, IsActive = true
                });
                added++;
            }
            await db.SaveChangesAsync();
            _bulk = "";
            Msg($"Import: +{added} přidáno (aktivní), {dup} už v katalogu.", false);
            await Load();
        }
        catch (Exception ex) { Msg("Chyba importu: " + ex.Message, true); }
        finally { _busy = false; }
    }

    private async Task ToggleActive(WhitelistDevice d)
    {
        _busy = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var e = await db.WhitelistDevices.FindAsync(d.Id);
            if (e is not null) { e.IsActive = !e.IsActive; await db.SaveChangesAsync(); }
            await Load();
        }
        catch (Exception ex) { Msg("Chyba: " + ex.Message, true); }
        finally { _busy = false; }
    }

    private void StartEdit(WhitelistDevice d)
    {
        _editId = d.Id; _eVid = d.VendorId; _ePid = d.ProductId; _eSerial = d.SerialNumber; _eDesc = d.Description;
    }

    private void CancelEdit() => _editId = null;

    private async Task SaveEdit()
    {
        if (_editId is null) return;
        _busy = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var d = await db.WhitelistDevices.FindAsync(_editId.Value);
            if (d is not null)
            {
                d.VendorId = (_eVid ?? "").Trim(); d.ProductId = (_ePid ?? "").Trim();
                d.SerialNumber = (_eSerial ?? "").Trim(); d.Description = (_eDesc ?? "").Trim();
                await db.SaveChangesAsync();
            }
            _editId = null;
            await Load();
        }
        catch (Exception ex) { Msg("Chyba uložení: " + ex.Message, true); }
        finally { _busy = false; }
    }

    private async Task Remove(int id)
    {
        _busy = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var d = await db.WhitelistDevices.FindAsync(id);
            if (d is not null) { db.WhitelistDevices.Remove(d); await db.SaveChangesAsync(); await Load(); }
        }
        catch (Exception ex) { Msg("Chyba: " + ex.Message, true); }
        finally { _busy = false; }
    }

    private void Msg(string text, bool bad) { _msg = text; _msgBad = bad; }
    private void Pub(string text, bool bad) { _pubMsg = text; _pubBad = bad; }

    // ① Vydat verzi: snapshot aktivního katalogu → kanonický whitelist.json blob (pending, nepodepsaný).
    private async Task PublishVersion()
    {
        _pubMsg = null; _sigMsg = null;
        _busy = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var active = await db.WhitelistDevices.Where(d => d.IsActive)
                .OrderBy(d => d.SerialNumber).ToListAsync();
            if (active.Count == 0) { Pub("Katalog nemá žádné aktivní zařízení.", true); return; }

            var now = DateTime.UtcNow;
            var validityDays = 365;
            var vd = await db.AppSettings.FirstOrDefaultAsync(s => s.Key == "whitelist.validityDays");
            if (int.TryParse(vd?.Value, out var dd) && dd > 0) validityDays = dd;
            var validUntil = now.AddDays(validityDays);

            // Unikátní verze yyyy-MM-dd-vN
            var total = await db.WhitelistVersions.CountAsync();
            var ver = $"{now:yyyy-MM-dd}-v{total + 1}";
            while (await db.WhitelistVersions.AnyAsync(v => v.Version == ver)) { total++; ver = $"{now:yyyy-MM-dd}-v{total + 1}"; }

            // Kanonický blob – přesně tyto bajty se podepíšou a budou servírovány agentům VERBATIM.
            var blobObj = new
            {
                version = ver,
                issuedAt = now,
                validUntil,
                signature = "",
                devices = active.Select(d => new
                {
                    vendorId = d.VendorId, productId = d.ProductId, serialNumber = d.SerialNumber,
                    description = d.Description, approvedAt = d.ApprovedAt, approvedBy = d.ApprovedBy,
                    validUntil = (DateTime?)null
                })
            };
            var blob = System.Text.Json.JsonSerializer.Serialize(blobObj,
                new System.Text.Json.JsonSerializerOptions { WriteIndented = false });

            // Smaž staré nepodepsané pending verze (nahradíme novou).
            var oldPending = await db.WhitelistVersions
                .Where(v => !v.IsActive && v.Signature == "" && v.Json != "").ToListAsync();
            db.WhitelistVersions.RemoveRange(oldPending);

            db.WhitelistVersions.Add(new WhitelistVersion
            {
                Version = ver, IssuedAt = now, ValidUntil = validUntil, IssuedBy = _user,
                Json = blob, Signature = "", IsActive = false
            });
            await db.SaveChangesAsync();
            Pub($"Verze {ver} vydána ({active.Count} zařízení). Stáhni whitelist.json, podepiš offline a nahraj .sig.", false);
            await Load();
        }
        catch (Exception ex) { Pub("Chyba vydání verze: " + ex.Message, true); }
        finally { _busy = false; }
    }

    // ④ Nahrát .sig: ověřit veřejným klíčem (pokud je v configu) → aktivovat verzi.
    private async Task OnSigSelected(InputFileChangeEventArgs e)
    {
        _sigMsg = null;
        if (_pending is null) return;
        _busy = true;
        try
        {
            using var stream = e.File.OpenReadStream(64 * 1024);
            using var sr = new StreamReader(stream);
            var sigText = (await sr.ReadToEndAsync()).Trim();
            if (string.IsNullOrEmpty(sigText)) { _sigMsg = "Soubor .sig je prázdný."; return; }

            var (ok, msg) = VerifySig(_pending.Json, sigText);
            if (!ok) { _sigMsg = "✗ " + msg; return; }

            await using var db = await DbFactory.CreateDbContextAsync();
            var pend = await db.WhitelistVersions.FindAsync(_pending.Id);
            if (pend is null) { _sigMsg = "Pending verze už neexistuje – vydej znovu."; await Load(); return; }

            foreach (var v in await db.WhitelistVersions.Where(v => v.IsActive).ToListAsync())
                v.IsActive = false;
            pend.Signature = sigText;
            pend.IsActive  = true;
            await db.SaveChangesAsync();
            Pub($"✔ Verze {pend.Version} podepsána a AKTIVOVÁNA ({msg}). Agenti ji stáhnou do ~2 min.", false);
            await Load();
        }
        catch (Exception ex) { _sigMsg = "Chyba nahrání .sig: " + ex.Message; }
        finally { _busy = false; }
    }

    // RSA-4096 ověření blobu proti podpisu (stejně jako agent SignatureVerifier / WhitelistSigner).
    // Veřejný klíč z configu Whitelist:PublicKeyPath; bez něj se aktivuje bez ověření (s upozorněním).
    private (bool ok, string msg) VerifySig(string blob, string sigBase64)
    {
        var keyPath = Config["Whitelist:PublicKeyPath"];
        if (string.IsNullOrWhiteSpace(keyPath) || !File.Exists(keyPath))
            return (true, "bez ověření – veřejný klíč není v configu (Whitelist:PublicKeyPath)");
        try
        {
            using var rsa = System.Security.Cryptography.RSA.Create();
            rsa.ImportFromPem(File.ReadAllText(keyPath));
            var data = System.Text.Encoding.UTF8.GetBytes(blob);
            var sig  = Convert.FromBase64String(sigBase64);
            var valid = rsa.VerifyData(data, sig,
                System.Security.Cryptography.HashAlgorithmName.SHA256,
                System.Security.Cryptography.RSASignaturePadding.Pkcs1);
            return (valid, valid ? "podpis platný" : "podpis NEPLATNÝ (jiný klíč nebo upravený soubor)");
        }
        catch (Exception ex) { return (false, "chyba ověření: " + ex.Message); }
    }
}
