@page "/stanice"
@inject IDbContextFactory<AppDbContext> DbFactory
@inject USBGuardian.Admin.AdSync.AdSyncRunner AdSync
@inject USBGuardian.Admin.Deploy.DeployTrigger Deploy

<h1>Stanice</h1>

@if (_error is not null)
{
    <div class="banner bad">Nelze načíst data z databáze: @_error</div>
}
else
{
    @if (_reqError is not null) { <div class="banner bad">@_reqError</div> }
    @if (_deployMsg is not null) { <div class="banner ok">@_deployMsg</div> }

    <div class="cards">
        <a class="card tile @(Stav is null ? "active" : "")" href="@Url(stav: "")">
            <div class="num">@_all.Count</div><div class="lbl">Stanic v AD</div></a>
        <a class="card tile @(Stav == "hlasi" ? "active" : "")" href="@Url(stav: "hlasi")">
            <div class="num">@_reporting</div><div class="lbl">Hlásí agenta</div></a>
        <a class="card tile @(_silent > 0 ? "warn" : "") @(Stav == "zmlkl" ? "active" : "")" href="@Url(stav: "zmlkl")">
            <div class="num">@_silent</div><div class="lbl">Zmlklo agentů</div></a>
        <a class="card tile bad @(Stav == "chybi" ? "active" : "")" href="@Url(stav: "chybi")">
            <div class="num">@_missing</div><div class="lbl">Chybí agent</div></a>
    </div>

    <div class="toolbar">
        <EditForm FormName="adsync-run" Model="_form" OnValidSubmit="UpdateAd">
            <button class="btn" type="submit">↻ Aktualizovat z AD</button>
        </EditForm>
        <EditForm FormName="req-all" Model="_form" OnValidSubmit="RequestReportAll">
            <button class="btn" type="submit" title="Vyžádat data od všech stanic, které hlásí agenta">⟳ Vyžádat data od všech</button>
        </EditForm>
        <EditForm FormName="excl-all" Model="_form" OnValidSubmit="ExcludeAll">
            <button class="btn" type="submit" title="Vyřadit z auto-nasazení VŠECHNY stanice bez agenta">⊘ Vyřadit vše z nasazení</button>
        </EditForm>
        <EditForm FormName="incl-all" Model="_form" OnValidSubmit="IncludeAll">
            <button class="btn" type="submit" title="Zrušit všechna vyřazení – zařadit vše zpět do auto-nasazení">✓ Zařadit vše</button>
        </EditForm>
        <span class="muted">AD sync: @AdSync.LastSummary@(AdSync.LastRunUtc is { } t ? $" ({t.ToLocalTime():HH:mm:ss})" : "")</span>
    </div>

    @* Bez tohohle řádku není poznat, jestli se něco nasadí samo, nebo ne.
       Pilulka "nasadí se" u stanice říká JEN "byla by mezi cíli". *@
    <div class="banner @(_autoDeploy ? "ok" : "")" style="margin:10px 0">
        @if (_autoDeploy)
        {
            <strong>Auto-nasazení je ZAPNUTÉ</strong>
            <span>— konzole sama vybírá cíle každých @_deployInterval min@(_deployDryRun ? " (zatím jen dry-run, nic neinstaluje)" : "").</span>
        }
        else
        {
            <strong>Auto-nasazení je vypnuté — samo se nenasadí nic.</strong>
            <span>Instalaci i aktualizaci spouštíš tlačítkem u stanice. Zapnout jde v <a href="nastaveni">Nastavení</a>.</span>
        }
        @if (!string.IsNullOrEmpty(_deployLastRun)) { <div class="muted">Poslední běh: @_deployLastRun</div> }
    </div>

    <div class="filterbar">
        <form method="get" class="searchform">
            @if (Stav is not null) { <input type="hidden" name="stav" value="@Stav" /> }
            @* Sloupcové filtry se nesou dál, aby je hledání nesmazalo. *@
            @if (!string.IsNullOrWhiteSpace(FHost)) { <input type="hidden" name="h" value="@FHost" /> }
            @if (!string.IsNullOrWhiteSpace(FOu))   { <input type="hidden" name="ou" value="@FOu" /> }
            @if (!string.IsNullOrWhiteSpace(FOs))   { <input type="hidden" name="os" value="@FOs" /> }
            @if (!string.IsNullOrWhiteSpace(FDom))  { <input type="hidden" name="dom" value="@FDom" /> }
            @if (!string.IsNullOrWhiteSpace(FVer))  { <input type="hidden" name="ver" value="@FVer" /> }
            @if (!string.IsNullOrEmpty(FIgn))       { <input type="hidden" name="ign" value="@FIgn" /> }
            @if (!string.IsNullOrEmpty(FNas))       { <input type="hidden" name="nas" value="@FNas" /> }
            <input class="inp" name="q" value="@Q" placeholder="hledat hostname / OS / cesta / doména" />
            <button class="btn" type="submit">Hledat</button>
        </form>
        @if (Stav is not null || !string.IsNullOrEmpty(Q)) { <a class="chip" href="stanice">✕ zrušit filtry</a> }
    </div>

    <h2>Inventář (@Filtered().Count() @(JeFiltrovano ? $"z {_all.Count}" : ""))</h2>

    @* Formulář stojí MIMO tabulku – <form> nesmí obalit <tr>. Políčka se k němu
       hlásí atributem form="fstanice", což HTML umožňuje. *@
    <form id="fstanice" method="get" class="no-print">
        @if (!string.IsNullOrEmpty(Q)) { <input type="hidden" name="q" value="@Q" /> }
    </form>

    <table>
        <thead>
            <tr>
                <th>Kom.</th><th>Hostname</th><th>Cesta v AD</th><th>OS</th><th>Doména</th>
                <th>Stav</th><th>Agent verze</th><th>Poslední kontakt</th><th data-no-print title="Trvalé vyřazení – hromadné akce se ho nedotknou">Ignorovat</th><th data-no-print>Nasazení</th><th data-no-print>Data</th>
            </tr>
            <tr class="filtry" data-no-print>
                <td></td>
                <td><input class="f" form="fstanice" name="h" value="@FHost" placeholder="hostname" /></td>
                <td><input class="f" form="fstanice" name="ou" value="@FOu" placeholder="OU" /></td>
                <td><input class="f" form="fstanice" name="os" value="@FOs" placeholder="OS" /></td>
                <td><input class="f" form="fstanice" name="dom" value="@FDom" placeholder="doména" /></td>
                <td>
                    <select class="f" form="fstanice" name="stav" onchange="this.form.requestSubmit()">
                        <option value="" selected="@(string.IsNullOrEmpty(Stav))">vše</option>
                        <option value="hlasi"  selected="@(Stav == "hlasi")">hlásí</option>
                        <option value="zmlkl"  selected="@(Stav == "zmlkl")">zmlkl</option>
                        <option value="chybi"  selected="@(Stav == "chybi")">chybí agent</option>
                        <option value="neniad" selected="@(Stav == "neniad")">není v AD</option>
                    </select>
                </td>
                <td><input class="f" form="fstanice" name="ver" value="@FVer" placeholder="commit" /></td>
                <td></td>
                <td data-no-print>
                    <select class="f" form="fstanice" name="ign" onchange="this.form.requestSubmit()">
                        <option value=""    selected="@(string.IsNullOrEmpty(FIgn))">vše</option>
                        <option value="ano" selected="@(FIgn == "ano")">ignorované</option>
                        <option value="ne"  selected="@(FIgn == "ne")">neignorované</option>
                    </select>
                </td>
                <td data-no-print>
                    <select class="f" form="fstanice" name="nas" onchange="this.form.requestSubmit()">
                        <option value=""           selected="@(string.IsNullOrEmpty(FNas))">vše</option>
                        <option value="nasadi"     selected="@(FNas == "nasadi")">nasadí se</option>
                        <option value="vyrazeno"   selected="@(FNas == "vyrazeno")">vyřazeno</option>
                        <option value="ignorovano" selected="@(FNas == "ignorovano")">ignorováno</option>
                    </select>
                </td>
                <td data-no-print>
                    <button class="btn" form="fstanice" type="submit" title="Použít filtry">Filtrovat</button>
                    @if (JeFiltrovano) { <a class="chip" href="stanice" title="Zrušit všechny filtry">✕</a> }
                </td>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Filtered())
            {
                <tr>
                    <td><span class="dot @CommClass(c)" title="@CommTitle(c)"></span></td>
                    <td>@c.Hostname</td>
                    <td class="muted">@(string.IsNullOrEmpty(c.AdPath) ? "—" : c.AdPath)</td>
                    <td>@c.OperatingSystem</td>
                    <td class="muted">@c.Domain</td>
                    <td>
                        @if (Reports(c)) { <span class="pill ok">hlásí</span> }
                        else if (c.InActiveDirectory) { <span class="pill bad">chybí agent</span> }
                        else { <span class="pill warn">není v AD</span> }
                    </td>
                    <td>@(string.IsNullOrEmpty(c.AgentVersion) ? "—" : c.AgentVersion)</td>
                    <td>@(c.LastSeen is null ? "—" : c.LastSeen.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm"))</td>
                    <td data-no-print>
                        @* Zaškrtávátko = trvalý úmysl operátora. Uloženo na řádku stanice,
                           takže ho "Zařadit vše" nepřepíše. *@
                        <EditForm FormName="@($"ign-{c.Hostname}")" Model="_form" OnValidSubmit="ToggleIgnore">
                            <input type="hidden" name="IgnHost" value="@c.Hostname" />
                            <input type="checkbox" checked="@c.DeployIgnored" onchange="this.form.requestSubmit()"
                                   title="@(c.DeployIgnored
                                            ? $"Trvale vyřazeno ze všech nasazení{IgnoredNote(c)} – kliknutím zrušíš"
                                            : "Trvale vyřadit ze všech nasazení (hromadné akce se toho nedotknou)")" />
                        </EditForm>
                    </td>
                    <td data-no-print>
                        @if (c.DeployIgnored)
                        {
                            <span class="pill off" title="Ignorováno@IgnoredNote(c)">ignorováno</span>
                        }
                        else if (c.InActiveDirectory && !Reports(c))
                        {
                            <EditForm FormName="@($"excl-{c.Hostname}")" Model="_form" OnValidSubmit="ToggleHostDeploy">
                                <input type="hidden" name="ExclHost" value="@c.Hostname" />
                                @if (EffectiveDeploy(c.Hostname))
                                {
                                    <span class="pill ok" title="Agent se na tuto stanici nasadí (auto-enrollment)">nasadí se</span>
                                    <button class="btn" type="submit" title="Vyřadit stanici z auto-nasazení agenta">Vyřadit</button>
                                }
                                else
                                {
                                    <span class="pill warn" title="Auto-nasazení agenta je pro tuto stanici vypnuté">vyřazeno</span>
                                    <button class="btn" type="submit" title="Znovu zařadit do auto-nasazení">Zařadit</button>
                                }
                            </EditForm>
                            @* Force: nečeká na nic a na nic se neptá pravidel — pošle právě tuhle stanici. *@
                            <EditForm FormName="@($"now-{c.Hostname}")" Model="_form" OnValidSubmit="NasaditTed">
                                <input type="hidden" name="NowHost" value="@c.Hostname" />
                                <button class="btn" type="submit"
                                        title="Nainstalovat agenta na tuhle stanici hned, bez ohledu na zařazení">▶ Nasadit teď</button>
                            </EditForm>
                        }
                        else { <span class="muted">—</span> }
                    </td>
                    <td data-no-print>
                        @if (Reports(c))
                        {
                            <EditForm FormName="@($"upd-{c.Hostname}")" Model="_form" OnValidSubmit="AktualizovatTed">
                                <input type="hidden" name="UpdHost" value="@c.Hostname" />
                                <button class="btn" type="submit"
                                        title="Nahrát na tuhle stanici verzi z kanálu stable (zastaví službu, vymění soubory, nastartuje)">⇪ Aktualizovat</button>
                            </EditForm>
                            <EditForm FormName="@($"req-{c.Hostname}")" Model="_form" OnValidSubmit="RequestReport">
                                <input type="hidden" name="ReqHost" value="@c.Hostname" />
                                <button class="btn" type="submit" title="Vyžádat aktuální data při nejbližším heartbeatu (do ~2 min)">⟳ Vyžádat</button>
                            </EditForm>
                            @if (_reqMap.TryGetValue(c.Hostname, out var req))
                            {
                                @if (c.LastSeen is null || req > c.LastSeen.Value)
                                {
                                    <span class="pill warn" title="Čeká na další heartbeat agenta (do ~2 min)">vyžádáno @req.ToLocalTime().ToString("HH:mm")</span>
                                }
                                else
                                {
                                    <span class="muted" title="Agent se ozval po vyžádání (@req.ToLocalTime().ToString("HH:mm"))">✓ ozval se @c.LastSeen.Value.ToLocalTime().ToString("HH:mm")</span>
                                }
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <p class="muted" data-no-print>Komunikace: <span class="dot ok"></span> komunikuje (≤ @_silentAfterMin min) ·
        <span class="dot warn"></span> zmlkl (starší) · <span class="dot off"></span> žádný kontakt</p>
}

@code {
    // Kdo vyřazení nastavil – jinak se za půl roku nikdo nedozví, proč se
    // na ten jeden stroj nenasazuje.
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthState { get; set; }

    [SupplyParameterFromQuery(Name = "stav")] public string? Stav { get; set; }
    [SupplyParameterFromQuery(Name = "q")]    public string? Q { get; set; }
    // Filtry po sloupcích – každý zvlášť, ať jde hledat "všechny NTB v Brně
    // bez agenta" a ne jen jedno slovo přes celou tabulku.
    [SupplyParameterFromQuery(Name = "h")]    public string? FHost { get; set; }
    [SupplyParameterFromQuery(Name = "ou")]   public string? FOu { get; set; }
    [SupplyParameterFromQuery(Name = "os")]   public string? FOs { get; set; }
    [SupplyParameterFromQuery(Name = "dom")]  public string? FDom { get; set; }
    [SupplyParameterFromQuery(Name = "ver")]  public string? FVer { get; set; }
    [SupplyParameterFromQuery(Name = "ign")]  public string? FIgn { get; set; }
    [SupplyParameterFromQuery(Name = "nas")]  public string? FNas { get; set; }
    [SupplyParameterFromForm]                 public string? ReqHost { get; set; }
    [SupplyParameterFromForm]                 public string? ExclHost { get; set; }
    [SupplyParameterFromForm]                 public string? IgnHost { get; set; }
    [SupplyParameterFromForm]                 public string? NowHost { get; set; }
    [SupplyParameterFromForm]                 public string? UpdHost { get; set; }

    private const int DefaultSilentAfterMinutes = 180;

    private string? _error;
    private List<Computer> _all = new();
    private int _reporting, _missing, _silent;
    private int _silentAfterMin = DefaultSilentAfterMinutes;
    private bool _autoDeploy, _deployDryRun = true;
    private string _deployInterval = "30", _deployLastRun = "";
    private readonly FormModel _form = new();
    private sealed class FormModel { }

    // hostname (UPPER) → čas posledního vyžádání dat (z AppSettings cmd.report.*)
    private Dictionary<string, DateTime> _reqMap = new(StringComparer.OrdinalIgnoreCase);
    private string? _reqError;
    private string? _deployMsg;   // chyba zápisu vyžádání (Load() ho nevynuluje)

    // Nasazování: default (deploy.defaultEnroll – pro nové PC, nastavuje se v Nastavení) + výjimky.
    // Efektivní stav = include ? ON : exclude ? OFF : default. Výjimky jdou jen ty, co se liší od defaultu.
    private bool _defaultEnroll = true;
    private HashSet<string> _include = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> _exclude = new(StringComparer.OrdinalIgnoreCase);
    private const string DefaultEnrollKey = "deploy.defaultEnroll";
    private const string IncludeKey = "deploy.includeHosts";
    private const string ExcludeKey = "deploy.excludeHosts";

    private bool EffectiveDeploy(string host) =>
        _include.Contains(host) ? true : _exclude.Contains(host) ? false : _defaultEnroll;

    private static bool Reports(Computer c) => !string.IsNullOrEmpty(c.AgentVersion) || c.LastSeen is not null;

    // Čerstvý = hlásil se v rámci prahu. Zmlklý = hlásí agenta, ale není čerstvý.
    private bool Fresh(Computer c) =>
        c.LastSeen is { } t && (DateTime.UtcNow - t).TotalMinutes <= _silentAfterMin;

    private bool Silent(Computer c) => Reports(c) && !Fresh(c);

    private string CommClass(Computer c)
    {
        if (c.LastSeen is null) return "off";
        return Fresh(c) ? "ok" : "warn";
    }

    private string CommTitle(Computer c) => c.LastSeen is null
        ? "Žádný kontakt s agentem"
        : Fresh(c)
            ? $"Komunikuje – naposledy {c.LastSeen.Value.ToLocalTime():dd.MM.yyyy HH:mm}"
            : $"Zmlkl (> {_silentAfterMin} min) – naposledy {c.LastSeen.Value.ToLocalTime():dd.MM.yyyy HH:mm}";

    private IEnumerable<Computer> Filtered()
    {
        IEnumerable<Computer> q = Stav switch
        {
            "hlasi" => _all.Where(Reports),
            "zmlkl" => _all.Where(Silent),
            "chybi" => _all.Where(c => c.InActiveDirectory && !Reports(c)),
            "neniad" => _all.Where(c => !c.InActiveDirectory),
            _       => _all
        };
        if (!string.IsNullOrWhiteSpace(Q))
        {
            var s = Q.Trim();
            q = q.Where(c =>
                (c.Hostname ?? "").Contains(s, StringComparison.OrdinalIgnoreCase) ||
                (c.OperatingSystem ?? "").Contains(s, StringComparison.OrdinalIgnoreCase) ||
                (c.AdPath ?? "").Contains(s, StringComparison.OrdinalIgnoreCase) ||
                (c.Domain ?? "").Contains(s, StringComparison.OrdinalIgnoreCase));
        }
        // Sloupcové filtry se skládají (AND) – zužují to, co prošlo dlaždicí a hledáním.
        q = Obsahuje(q, FHost, c => c.Hostname);
        q = Obsahuje(q, FOu,   c => c.AdPath);
        q = Obsahuje(q, FOs,   c => c.OperatingSystem);
        q = Obsahuje(q, FDom,  c => c.Domain);
        q = Obsahuje(q, FVer,  c => c.AgentVersion);

        if (FIgn == "ano") q = q.Where(c => c.DeployIgnored);
        else if (FIgn == "ne") q = q.Where(c => !c.DeployIgnored);

        q = FNas switch
        {
            "ignorovano" => q.Where(c => c.DeployIgnored),
            "nasadi"     => q.Where(c => !c.DeployIgnored && c.InActiveDirectory && !Reports(c) && EffectiveDeploy(c.Hostname)),
            "vyrazeno"   => q.Where(c => !c.DeployIgnored && c.InActiveDirectory && !Reports(c) && !EffectiveDeploy(c.Hostname)),
            _            => q
        };

        return q;
    }

    private static IEnumerable<Computer> Obsahuje(IEnumerable<Computer> q, string? hledane,
                                                  Func<Computer, string?> pole)
    {
        if (string.IsNullOrWhiteSpace(hledane)) return q;
        var s = hledane.Trim();
        return q.Where(c => (pole(c) ?? "").Contains(s, StringComparison.OrdinalIgnoreCase));
    }

    private bool JeFiltrovano =>
        !string.IsNullOrEmpty(Stav) || !string.IsNullOrEmpty(Q) ||
        !string.IsNullOrWhiteSpace(FHost) || !string.IsNullOrWhiteSpace(FOu) ||
        !string.IsNullOrWhiteSpace(FOs) || !string.IsNullOrWhiteSpace(FDom) ||
        !string.IsNullOrWhiteSpace(FVer) || !string.IsNullOrEmpty(FIgn) || !string.IsNullOrEmpty(FNas);

    private const string ReqKeyPrefix = "cmd.report.";

    private static async Task<Dictionary<string, DateTime>> LoadReportRequests(AppDbContext db)
    {
        var map = new Dictionary<string, DateTime>(StringComparer.OrdinalIgnoreCase);
        try
        {
            var rows = await db.AppSettings.Where(s => s.Key.StartsWith(ReqKeyPrefix)).ToListAsync();
            foreach (var r in rows)
            {
                if (DateTime.TryParse(r.Value, System.Globalization.CultureInfo.InvariantCulture,
                        System.Globalization.DateTimeStyles.RoundtripKind, out var t))
                    map[r.Key.Substring(ReqKeyPrefix.Length)] = t;
            }
        }
        catch { /* AppSettings nemusí existovat – degraduje na žádné vyžádání */ }
        return map;
    }

    private async Task RequestReport()
    {
        if (!string.IsNullOrWhiteSpace(ReqHost))
            await SetReportRequest(new[] { ReqHost.Trim() });
        await Load();
    }

    private async Task RequestReportAll()
    {
        await SetReportRequest(_all.Where(Reports).Select(c => c.Hostname));
        await Load();
    }

    private async Task SetReportRequest(IEnumerable<string> hosts)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var now = DateTime.UtcNow.ToString("o");
            foreach (var h in hosts.Where(h => !string.IsNullOrWhiteSpace(h)))
            {
                var key = ReqKeyPrefix + h.Trim().ToUpperInvariant();
                var row = await db.AppSettings.FirstOrDefaultAsync(s => s.Key == key);
                if (row is null) db.AppSettings.Add(new AppSetting { Key = key, Value = now });
                else            row.Value = now;
            }
            await db.SaveChangesAsync();
            _reqError = null;
        }
        catch (Exception ex) { _reqError = "Vyžádání se nepodařilo uložit: " + ex.Message; }
    }

    private static readonly char[] ListSep = { ',', ';', '\n', '\r' };

    private static async Task<HashSet<string>> LoadList(AppDbContext db, string key)
    {
        var set = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        try
        {
            var row = await db.AppSettings.FirstOrDefaultAsync(s => s.Key == key);
            if (!string.IsNullOrWhiteSpace(row?.Value))
                foreach (var h in row.Value.Split(ListSep, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                    set.Add(h);
        }
        catch { /* AppSettings nemusí existovat */ }
        return set;
    }

    private static async Task SaveList(AppDbContext db, string key, HashSet<string> set)
    {
        var value = string.Join(",", set.OrderBy(x => x, StringComparer.OrdinalIgnoreCase));
        var row = await db.AppSettings.FirstOrDefaultAsync(s => s.Key == key);
        if (row is null) db.AppSettings.Add(new AppSetting { Key = key, Value = value });
        else            row.Value = value;
    }

    // Nastaví efektivní nasazení daných hostů na target; výjimku drží jen když se liší od defaultu.
    private async Task SetHostsDeploy(IEnumerable<string> hosts, bool target)
    {
        var list = hosts.Where(h => !string.IsNullOrWhiteSpace(h)).Select(h => h.Trim()).ToList();
        if (list.Count == 0) { await Load(); return; }
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var inc = await LoadList(db, IncludeKey);
            var exc = await LoadList(db, ExcludeKey);
            foreach (var h in list)
            {
                inc.Remove(h); exc.Remove(h);
                if (target != _defaultEnroll) (target ? inc : exc).Add(h);
            }
            await SaveList(db, IncludeKey, inc);
            await SaveList(db, ExcludeKey, exc);
            await db.SaveChangesAsync();
            _reqError = null;
        }
        catch (Exception ex) { _reqError = "Změnu nasazení se nepodařilo uložit: " + ex.Message; }
        await Load();
    }

    private async Task ToggleHostDeploy()
    {
        var host = ExclHost?.Trim();
        if (!string.IsNullOrEmpty(host)) await SetHostsDeploy(new[] { host }, !EffectiveDeploy(host));
        else await Load();
    }

    // Přepnutí trvalého vyřazení. Zapisuje se na řádek stanice, ne do seznamu
    // v nastavení – proto to hromadné akce nepřepíšou.
    private async Task NasaditTed()
    {
        var host = NowHost?.Trim();
        if (string.IsNullOrEmpty(host)) { await Load(); return; }
        var (ok, zprava) = await Deploy.SpustAsync(host, USBGuardian.Admin.Deploy.DeployTrigger.Akce.Instalace,
                                                   await CurrentUser());
        _reqError = ok ? null : zprava;
        _deployMsg = ok ? zprava : null;
        await Load();
    }

    private async Task AktualizovatTed()
    {
        var host = UpdHost?.Trim();
        if (string.IsNullOrEmpty(host)) { await Load(); return; }
        var (ok, zprava) = await Deploy.SpustAsync(host, USBGuardian.Admin.Deploy.DeployTrigger.Akce.Aktualizace,
                                                   await CurrentUser());
        _reqError = ok ? null : zprava;
        _deployMsg = ok ? zprava : null;
        await Load();
    }

    private async Task ToggleIgnore()
    {
        var host = IgnHost?.Trim();
        if (string.IsNullOrEmpty(host)) { await Load(); return; }
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var pc = await db.Computers.FirstOrDefaultAsync(c => c.Hostname == host);
            if (pc is not null)
            {
                pc.DeployIgnored = !pc.DeployIgnored;
                pc.DeployIgnoredBy = pc.DeployIgnored ? await CurrentUser() : null;
                pc.DeployIgnoredAt = pc.DeployIgnored ? DateTime.UtcNow : null;
                await db.SaveChangesAsync();
            }
            _reqError = null;
        }
        catch (Exception ex) { _reqError = "Změnu se nepodařilo uložit: " + ex.Message; }
        await Load();
    }

    private async Task<string> CurrentUser()
    {
        if (AuthState is null) return "?";
        try { return (await AuthState).User.Identity?.Name ?? "?"; }
        catch { return "?"; }
    }

    private static string IgnoredNote(Computer c) =>
        string.IsNullOrEmpty(c.DeployIgnoredBy) ? ""
        : $" ({c.DeployIgnoredBy}{(c.DeployIgnoredAt is { } t ? ", " + t.ToLocalTime().ToString("dd.MM.yyyy") : "")})";

    // Hromadné akce se ignorovaných stanic ZÁMĚRNĚ netýkají.
    private List<string> DeployCandidates() =>
        _all.Where(c => c.InActiveDirectory && !Reports(c) && !c.DeployIgnored)
            .Select(c => c.Hostname).ToList();

    private Task ExcludeAll() => SetHostsDeploy(DeployCandidates(), target: false);
    private Task IncludeAll() => SetHostsDeploy(DeployCandidates(), target: true);

    private static async Task<int> LoadSilentThreshold(AppDbContext db)
    {
        try
        {
            var row = await db.AppSettings.FirstOrDefaultAsync(s => s.Key == "comm.silentAfterMinutes");
            return int.TryParse(row?.Value, out var v) && v > 0 ? v : DefaultSilentAfterMinutes;
        }
        catch { return DefaultSilentAfterMinutes; }
    }

    // Dlaždice mění jen "stav" – ostatní filtry si nese s sebou, jinak by
    // kliknutí na dlaždici tiše zahodilo, co má člověk nastavené ve sloupcích.
    private string Url(string stav)
    {
        var parts = new List<string>();
        if (!string.IsNullOrEmpty(stav)) parts.Add($"stav={stav}");
        if (!string.IsNullOrEmpty(Q)) parts.Add($"q={Uri.EscapeDataString(Q)}");
        void Pridej(string k, string? v) { if (!string.IsNullOrWhiteSpace(v)) parts.Add($"{k}={Uri.EscapeDataString(v)}"); }
        Pridej("h", FHost); Pridej("ou", FOu); Pridej("os", FOs);
        Pridej("dom", FDom); Pridej("ver", FVer); Pridej("ign", FIgn); Pridej("nas", FNas);
        return parts.Count > 0 ? "stanice?" + string.Join("&", parts) : "stanice";
    }

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            _silentAfterMin = await LoadSilentThreshold(db);

            // Stav auto-nasazení – ať je na stránce vidět, jestli se něco stane samo.
            var st = await db.AppSettings.ToListAsync();
            string Nast(string k) => st.FirstOrDefault(x => x.Key == k)?.Value ?? "";
            _autoDeploy    = string.Equals(Nast("deploy.enabled"), "true", StringComparison.OrdinalIgnoreCase);
            _deployDryRun  = !string.Equals(Nast("deploy.dryRun"), "false", StringComparison.OrdinalIgnoreCase);
            var di = Nast("deploy.intervalMinutes"); _deployInterval = string.IsNullOrEmpty(di) ? "30" : di;
            _deployLastRun = Nast("deploy.lastRun");
            _reqMap = await LoadReportRequests(db);
            var defRow = await db.AppSettings.FirstOrDefaultAsync(s => s.Key == DefaultEnrollKey);
            _defaultEnroll = !string.Equals(defRow?.Value, "false", StringComparison.OrdinalIgnoreCase); // default ON
            _include = await LoadList(db, IncludeKey);
            _exclude = await LoadList(db, ExcludeKey);
            _all = await db.Computers.OrderBy(c => c.Hostname).ToListAsync();
            _reporting = _all.Count(Reports);
            _silent    = _all.Count(Silent);
            _missing   = _all.Count(c => c.InActiveDirectory && !Reports(c));
            _error = null;
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task UpdateAd()
    {
        await AdSync.RunOnceAsync();
        await Load();
    }
}
