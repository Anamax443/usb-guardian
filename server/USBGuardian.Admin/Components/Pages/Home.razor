@page "/"
@inject IDbContextFactory<AppDbContext> DbFactory

<h1>Přehled</h1>

<p class="intro"><strong>USB Guardian</strong> sleduje paměťová média (USB / SD / disky) na firemních
stanicích — neschválené médium je varováno nebo zablokováno. Incidenty lze filtrovat a kumulovat.
Inventář stanic → <a href="stanice">Stanice</a>, schvalování → <a href="whitelist">Whitelist</a>.</p>

@if (_error is not null)
{
    <div class="banner bad">Nelze načíst data z databáze: @_error</div>
}
else
{
    <div class="cards">
        <a class="card tile" href="stanice">
            <div class="num">@_compTotal</div><div class="lbl">Stanic v AD</div></a>
        <a class="card tile @(_compMissing > 0 ? "bad" : "")" href="stanice?stav=chybi">
            <div class="num">@_compMissing</div><div class="lbl">Chybí agent</div></a>
        <a class="card tile" href="whitelist">
            <div class="num">@_wlActive</div><div class="lbl">Schválených médií</div></a>
        <a class="card tile @(_wlPending > 0 ? "warn" : "")" href="whitelist">
            <div class="num">@_wlPending</div><div class="lbl">Deaktivovaných médií</div></a>
        <a class="card tile @(_action is null ? "active" : "")" href="@Url(action: "")">
            <div class="num">@_total</div><div class="lbl">Incidentů (@WindowLabel)</div></a>
        <a class="card tile @(_blocked > 0 ? "bad" : "") @(_action == "Blocked" ? "active" : "")" href="@Url(action: "Blocked")">
            <div class="num">@_blocked</div><div class="lbl">Blokováno</div></a>
        <a class="card tile @(_warned > 0 ? "warn" : "") @(_action == "Warned" ? "active" : "")" href="@Url(action: "Warned")">
            <div class="num">@_warned</div><div class="lbl">Varování</div></a>
    </div>

    <div class="filterbar">
        <span class="muted">Období:</span>
        @foreach (var (d, lbl) in new[] { (30, "30 dní"), (90, "90 dní"), (365, "rok"), (0, "vše") })
        {
            <a class="chip @(_days == d ? "active" : "")" href="@Url(days: d)">@lbl</a>
        }
        <span class="sep"></span>
        <a class="chip @(_group ? "active" : "")" href="@Url(group: !_group)">@(_group ? "kumulováno" : "detailně")</a>
        <form method="get" class="searchform">
            @if (_action is not null) { <input type="hidden" name="action" value="@_action" /> }
            @if (_days != 30) { <input type="hidden" name="days" value="@_days" /> }
            @if (!_group) { <input type="hidden" name="group" value="0" /> }
            @if (_sort != "time") { <input type="hidden" name="sort" value="@_sort" /> }
            @if (!_desc) { <input type="hidden" name="dir" value="asc" /> }
            <input class="inp" name="q" value="@_q" placeholder="hledat stanice / uživatel / médium / S/N" />
            <button class="btn" type="submit">Hledat</button>
        </form>
        @if (_action is not null || !string.IsNullOrEmpty(_q) || _days != 30 || !_group)
        {
            <a class="chip" href="">✕ zrušit filtry</a>
        }
        <span class="sep"></span>
        <a class="chip" href="@ExportUrl("/export/incidents.csv")" title="Export incidentů do CSV (Excel) dle aktivního filtru">⬇ CSV</a>
        <a class="chip" href="@ExportUrl("/export/manager")" target="_blank" title="Manažerský report (souhrn, tisk / uložit PDF)">📊 Report</a>
    </div>

    @if (_group)
    {
        <h2>Kumulované (@_agg.Count)</h2>
        @if (_agg.Count == 0) { <p class="muted">Žádné incidenty za zvolené období.</p> }
        else
        {
            <table>
                <thead>
                    <tr><th>Médium</th><th>VID</th><th>PID</th><th>Sériové číslo</th><th>Velikost</th><th>Stanice</th><th>Uživatel</th><th>Počet</th><th>Stav</th><th>Schváleno</th><th>Poslední</th></tr>
                </thead>
                <tbody>
                    @foreach (var g in _agg)
                    {
                        <tr>
                            <td>@g.Name</td>
                            <td class="mono">@g.Vendor</td>
                            <td class="mono">@g.Product</td>
                            <td class="mono">@(string.IsNullOrEmpty(g.Serial) ? "—" : g.Serial)</td>
                            <td class="muted">@FormatSize(g.Size)</td>
                            <td>@g.Hostname</td>
                            <td>@g.Username</td>
                            <td><strong>@g.Count×</strong></td>
                            <td>
                                @if (g.Blocked > 0) { <span class="pill bad">Blokováno @g.Blocked×</span> }
                                else if (g.Warned > 0) { <span class="pill warn">Varování @g.Warned×</span> }
                                else { <span class="pill ok">Povoleno</span> }
                            </td>
                            <td>
                                @if (Approved(g.Serial)) { <span class="pill ok">ano</span> }
                                else { <span class="pill bad">ne</span> }
                            </td>
                            <td class="mono">@g.Last.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
    else
    {
        <h2>Detailně (@_recent.Count)</h2>
        @if (_recent.Count == 0) { <p class="muted">Žádné incidenty za zvolené období.</p> }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th><a class="sortlink" href="@SortUrl("time")">@SortHeader("time", "Čas")</a></th>
                        <th><a class="sortlink" href="@SortUrl("host")">@SortHeader("host", "Stanice")</a></th>
                        <th><a class="sortlink" href="@SortUrl("user")">@SortHeader("user", "Uživatel")</a></th>
                        <th><a class="sortlink" href="@SortUrl("media")">@SortHeader("media", "Médium")</a></th>
                        <th><a class="sortlink" href="@SortUrl("vid")">@SortHeader("vid", "VID")</a></th>
                        <th><a class="sortlink" href="@SortUrl("pid")">@SortHeader("pid", "PID")</a></th>
                        <th><a class="sortlink" href="@SortUrl("serial")">@SortHeader("serial", "Sériové číslo")</a></th>
                        <th><a class="sortlink" href="@SortUrl("size")">@SortHeader("size", "Velikost")</a></th>
                        <th><a class="sortlink" href="@SortUrl("action")">@SortHeader("action", "Akce")</a></th>
                        <th>Schváleno</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in _recent)
                    {
                        <tr>
                            <td class="mono">@i.Timestamp.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@i.Hostname</td>
                            <td>@i.Username</td>
                            <td>@i.FriendlyName</td>
                            <td class="mono">@i.VendorId</td>
                            <td class="mono">@i.ProductId</td>
                            <td class="mono">@i.SerialNumber</td>
                            <td class="muted">@FormatSize(i.SizeBytes)</td>
                            <td><span class="pill @PillClass(i.Action)">@i.Action</span></td>
                            <td>
                                @if (Approved(i.SerialNumber)) { <span class="pill ok">ano</span> }
                                else { <span class="pill bad">ne</span> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
}

@code {
    [SupplyParameterFromQuery(Name = "action")] public string? ActionParam { get; set; }
    [SupplyParameterFromQuery(Name = "days")]   public int? DaysParam { get; set; }
    [SupplyParameterFromQuery(Name = "q")]      public string? QParam { get; set; }
    [SupplyParameterFromQuery(Name = "group")]  public int? GroupParam { get; set; }
    [SupplyParameterFromQuery(Name = "sort")]   public string? SortParam { get; set; }
    [SupplyParameterFromQuery(Name = "dir")]    public string? DirParam { get; set; }

    private string? _action;
    private int _days;
    private string? _q;
    private bool _group;
    private string _sort = "time";
    private bool _desc = true;

    private string? _error;
    private int _total, _blocked, _warned;
    private int _compTotal, _compMissing, _wlActive, _wlPending;
    private List<Agg> _agg = new();
    private List<Incident> _recent = new();
    private HashSet<string> _approvedSerials = new(StringComparer.OrdinalIgnoreCase);

    // Aktuálně schváleno = aktivní položka whitelistu se stejným sériovým číslem
    private bool Approved(string serial) => !string.IsNullOrWhiteSpace(serial) && _approvedSerials.Contains(serial.Trim());

    private string WindowLabel => _days == 0 ? "vše" : _days == 365 ? "rok" : $"{_days} dní";

    private record Agg(string Name, string Vendor, string Product, string Serial,
                       string Hostname, string Username, int Count, int Blocked, int Warned, long Size, DateTime Last);

    protected override async Task OnInitializedAsync()
    {
        _action = string.IsNullOrWhiteSpace(ActionParam) ? null : ActionParam;
        _days   = DaysParam ?? 30;
        _q      = string.IsNullOrWhiteSpace(QParam) ? null : QParam.Trim();
        _group  = (GroupParam ?? 1) == 1;
        _sort   = string.IsNullOrWhiteSpace(SortParam) ? "time" : SortParam.Trim().ToLowerInvariant();
        _desc   = !string.Equals(DirParam, "asc", StringComparison.OrdinalIgnoreCase);

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var from = _days == 0 ? DateTime.MinValue : DateTime.UtcNow.AddDays(-_days);

            var baseq = db.Incidents.Where(i => i.Timestamp >= from);
            if (_action is not null) baseq = baseq.Where(i => i.Action == _action);
            if (_q is not null)
                baseq = baseq.Where(i =>
                    i.Hostname.Contains(_q) || i.Username.Contains(_q) ||
                    i.FriendlyName.Contains(_q) || i.SerialNumber.Contains(_q));

            // dlaždice počítají přes okno (bez action filtru, ale s hledáním)
            var win = db.Incidents.Where(i => i.Timestamp >= from);
            if (_q is not null)
                win = win.Where(i => i.Hostname.Contains(_q) || i.Username.Contains(_q) ||
                                     i.FriendlyName.Contains(_q) || i.SerialNumber.Contains(_q));
            _total     = await win.CountAsync();
            _blocked   = await win.CountAsync(i => i.Action == "Blocked");
            _warned    = await win.CountAsync(i => i.Action == "Warned");

            // souhrnné dlaždice z ostatních listů (dlaždicový přehled)
            _compTotal   = await db.Computers.CountAsync();
            _compMissing = await db.Computers.CountAsync(c => c.InActiveDirectory && c.AgentVersion == "" && c.LastSeen == null);
            _wlActive    = await db.WhitelistDevices.CountAsync(d => d.IsActive);
            _wlPending   = await db.WhitelistDevices.CountAsync(d => !d.IsActive);

            // aktuálně schválená sériová čísla (z aktivního whitelistu)
            var wlSerials = await db.WhitelistDevices.Where(d => d.IsActive && d.SerialNumber != "")
                    .Select(d => d.SerialNumber).ToListAsync();
            _approvedSerials = new HashSet<string>(
                wlSerials.Select(s => s.Trim()), StringComparer.OrdinalIgnoreCase);

            if (_group)
            {
                var raw = await baseq
                    .GroupBy(i => new { i.SerialNumber, i.Hostname, i.Username })
                    .Select(g => new
                    {
                        g.Key.SerialNumber, g.Key.Hostname, g.Key.Username,
                        Name    = g.Max(x => x.FriendlyName),
                        Vendor  = g.Max(x => x.VendorId),
                        Product = g.Max(x => x.ProductId),
                        Count   = g.Count(),
                        Blocked = g.Sum(x => x.Action == "Blocked" ? 1 : 0),
                        Warned  = g.Sum(x => x.Action == "Warned" ? 1 : 0),
                        Size    = g.Max(x => x.SizeBytes),
                        Last    = g.Max(x => x.Timestamp)
                    })
                    .OrderByDescending(x => x.Last)
                    .Take(300)
                    .ToListAsync();

                _agg = raw.Select(x => new Agg(
                    x.Name ?? "", x.Vendor ?? "", x.Product ?? "", x.SerialNumber, x.Hostname, x.Username,
                    x.Count, x.Blocked, x.Warned, x.Size, x.Last)).ToList();
            }
            else
            {
                _recent = await SortDetail(baseq).Take(200).ToListAsync();
            }
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    // sestaví query string se zachováním ostatních filtrů
    private string Url(string? action = "_keep", int? days = null, bool? group = null)
    {
        var a = action == "_keep" ? _action : (string.IsNullOrEmpty(action) ? null : action);
        var d = days ?? _days;
        var g = group ?? _group;
        var parts = new List<string>();
        if (a is not null) parts.Add($"action={a}");
        if (d != 30) parts.Add($"days={d}");
        if (_q is not null) parts.Add($"q={Uri.EscapeDataString(_q)}");
        if (!g) parts.Add("group=0");
        if (_sort != "time") parts.Add($"sort={_sort}");
        if (!_desc) parts.Add("dir=asc");
        return parts.Count > 0 ? "?" + string.Join("&", parts) : "";
    }

    // Klik na hlavičku: toggluje směr na aktivním sloupci, nový sloupec → sestupně.
    private string SortUrl(string key)
    {
        var desc = _sort == key ? !_desc : true;
        var parts = new List<string>();
        if (_action is not null) parts.Add($"action={_action}");
        if (_days != 30) parts.Add($"days={_days}");
        if (_q is not null) parts.Add($"q={Uri.EscapeDataString(_q)}");
        if (!_group) parts.Add("group=0");
        if (key != "time") parts.Add($"sort={key}");
        if (!desc) parts.Add("dir=asc");
        return parts.Count > 0 ? "?" + string.Join("&", parts) : "";
    }

    private string SortHeader(string key, string label) =>
        _sort == key ? label + (_desc ? " ▼" : " ▲") : label;

    // Export odkaz se zachováním aktivního filtru (období / akce / hledání).
    private string ExportUrl(string basePath)
    {
        var parts = new List<string>();
        if (_action is not null) parts.Add($"action={Uri.EscapeDataString(_action)}");
        if (_days != 30) parts.Add($"days={_days}");
        if (_q is not null) parts.Add($"q={Uri.EscapeDataString(_q)}");
        return parts.Count > 0 ? basePath + "?" + string.Join("&", parts) : basePath;
    }

    private IQueryable<Incident> SortDetail(IQueryable<Incident> q)
    {
        var d = _desc;
        return _sort switch
        {
            "host"   => d ? q.OrderByDescending(i => i.Hostname)     : q.OrderBy(i => i.Hostname),
            "user"   => d ? q.OrderByDescending(i => i.Username)     : q.OrderBy(i => i.Username),
            "media"  => d ? q.OrderByDescending(i => i.FriendlyName) : q.OrderBy(i => i.FriendlyName),
            "vid"    => d ? q.OrderByDescending(i => i.VendorId)     : q.OrderBy(i => i.VendorId),
            "pid"    => d ? q.OrderByDescending(i => i.ProductId)    : q.OrderBy(i => i.ProductId),
            "serial" => d ? q.OrderByDescending(i => i.SerialNumber) : q.OrderBy(i => i.SerialNumber),
            "size"   => d ? q.OrderByDescending(i => i.SizeBytes)    : q.OrderBy(i => i.SizeBytes),
            "action" => d ? q.OrderByDescending(i => i.Action)       : q.OrderBy(i => i.Action),
            _        => d ? q.OrderByDescending(i => i.Timestamp)    : q.OrderBy(i => i.Timestamp),
        };
    }

    private static string PillClass(string action) => action switch
    {
        "Blocked" => "bad", "Warned" => "warn", _ => "ok"
    };

    private static string FormatSize(long bytes) => bytes > 0 ? $"{bytes / 1_073_741_824.0:F1} GB" : "—";
}
