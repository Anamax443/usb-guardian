@page "/nastaveni"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Net.Mail
@using USBGuardian.Admin.Notifications
@using USBGuardian.Admin.Maintenance
@inject IConfiguration Config
@inject IDbContextFactory<AppDbContext> DbFactory
@inject USBGuardian.Admin.Security.AccessCache Access
@inject ServiceRestartRunner Restart
@inject USBGuardian.Admin.Ui.UiStyleCache UiCache
@inject NavigationManager Nav
@inject USBGuardian.Admin.Deploy.DeployTrigger Deploy

<h1>Nastavení</h1>

@if (_dbError is not null)
{
    <div class="banner bad">Centrální nastavení nedostupné: @_dbError<br/>
        <span class="muted">Spusť <code>database/06_appsettings.sql</code> a grant na <code>AppSettings</code> pro účet konzole.</span></div>
}

<h2>Vzhled konzole</h2>
<p class="muted">Styl a rozvržení z <strong>banky UI</strong> (repo <span class="mono">Anamax443/Interface-Par</span>,
    katalog <span class="mono">mockup/ui-styly-katalog.html</span>). Styl mění barvy, písma a míry;
    rozvržení mění kostru okna. Obsah stránek je v obou případech týž.</p>
<dl class="cfg">
    <dt>Styl</dt>
    <dd>
        <select class="inp" @bind="_uiStyle">
            @foreach (var st in USBGuardian.Admin.Ui.UiStyleCache.Styles)
            {
                <option value="@st.Id">@st.Label</option>
            }
        </select>
    </dd>
    <dt>Rozvržení</dt>
    <dd>
        <select class="inp" @bind="_uiLayout">
            @foreach (var la in USBGuardian.Admin.Ui.UiStyleCache.Layouts)
            {
                <option value="@la.Id">@la.Label</option>
            }
        </select>
    </dd>
    <dt>Právě nasazeno</dt>
    <dd class="mono">@UiCache.Style · @UiCache.Layout</dd>
</dl>
<div class="toolbar">
    <button class="btn" @onclick="SaveUi" disabled="@_busy">Uložit vzhled</button>
</div>
@if (_uiMsg is not null) { <div class="banner @(_uiBad ? "bad" : "ok")">@_uiMsg</div> }

<h2>Vynucování</h2>
<dl class="cfg">
    <dt>Aktivně vyžadovat pouze schválená média</dt>
    <dd>
        @if (_enforce) { <span class="pill bad">ZAPNUTO — blokovat neschválená</span> }
        else           { <span class="pill warn">vypnuto — jen varovat</span> }
        &nbsp;<button class="btn" @onclick="ToggleEnforce" disabled="@_busy">@(_enforce ? "Vypnout" : "Zapnout")</button>
    </dd>
</dl>
<p class="muted">Centrální politika. Agenti ji začnou respektovat po doplnění distribuce přes heartbeat
(další krok, sdílený s blocklistem). Dnes agent jede dle lokálního <code>policy.mode</code>.</p>

<h2>Dohled komunikace</h2>
<dl class="cfg">
    <dt>Agent platí za zmlklý po (min)</dt>
    <dd>
        <input class="inp" style="min-width:90px" @bind="_silentAfter" />
        &nbsp;<button class="btn" @onclick="SaveComm" disabled="@_busy">Uložit</button>
        @if (_commMsg is not null) { <span class="muted">&nbsp;@_commMsg</span> }
    </dd>
</dl>
<p class="muted">Hranice pro tečku komunikace i dlaždici „Zmlklo agentů" na Stanicích. Stanice, která dřív
    hlásila agenta a déle se neozvala, se počítá jako zmlklá (možný výpadek / tamper). Default 180 min.</p>

<h2>Verze agenta</h2>
<p class="muted">Archiv balíčků na tomto serveru. <strong>Stable</strong> je verze pro fleet,
    <strong>beta</strong> pro vzorek stanic, na kterém se nová verze nejdřív osvědčí. Ostatní verze
    jsou archiv — nerozvážejí se nikam, ale je z čeho se vrátit, když se nasazená ukáže jako špatná.
    Tady se volí <em>záměr</em>; přepnutí provede dávka <span class="mono">Set-AgentVersion.cmd</span>.</p>
@if (_verzeChyba is not null)
{
    <div class="banner bad">Archiv verzí nelze číst: @_verzeChyba</div>
}
<dl class="cfg">
    <dt>Složka archivu</dt>
    <dd>
        <input class="inp" @bind="_verzeDir" placeholder="C:\Apps\USBGuardianAgentVersions" />
        <div class="muted">Podsložka = jeden commit agenta.</div>
    </dd>
    <dt>Stable (fleet)</dt>
    <dd>
        <select class="inp" @bind="_verzeStable">
            <option value="">— nezvoleno —</option>
            @foreach (var v in _verze) { <option value="@v">@v</option> }
        </select>
    </dd>
    <dt>Beta (vzorek stanic)</dt>
    <dd>
        <select class="inp" @bind="_verzeBeta">
            <option value="">— nezvoleno —</option>
            @foreach (var v in _verze) { <option value="@v">@v</option> }
        </select>
    </dd>
    <dt>Beta stanice (vzorek)</dt>
    <dd>
        <textarea class="inp" style="min-width:420px;height:70px;font-family:var(--font-mono);font-size:12px"
                  @bind="_betaHosts" placeholder="PC01&#10;PC02&#10;PC03"></textarea>
        <div class="muted">Stálý vzorek 3–4 strojů, na kterém se nová verze zkouší. Jeden hostname na řádek.
            Zapisuje se do <span class="mono">update-beta.txt</span>, odkud si ho vezme úloha
            <span class="mono">UpdateAgentBeta</span> — nemusíš ho psát znovu při každé verzi.</div>
    </dd>
    <dt>Archivovat verzí (nejvýš)</dt>
    <dd>
        <input class="inp" style="min-width:90px" @bind="_verzeKeep" />
        <div class="muted">Každý balíček má přes 100 MB. Nejstarší nad tento počet se při archivaci mažou —
            kromě té, která je právě stable nebo beta. Zapisuje se do <span class="mono">keep.txt</span>
            ve složce archivu, odkud si ho dávka přečte. Default 10.</div>
    </dd>
    <dt>V archivu</dt>
    <dd class="mono">@(_verze.Count == 0 ? "—" : string.Join(" · ", _verze))</dd>
</dl>
<div class="toolbar">
    <button class="btn" @onclick="SaveVerze" disabled="@_busy">Uložit verze</button>
    <button class="btn" @onclick="RozvezBetu" disabled="@(_busy || string.IsNullOrEmpty(_verzeBeta) || string.IsNullOrWhiteSpace(_betaHosts))"
            title="Nahraje aktuální obsah beta kanálu na schválený vzorek stanic HNED - bez čekání na ruční schtasks/RDU.">
        ⇪ Rozvézt betu na vzorek
    </button>
    <button class="btn" @onclick="PovysitBetu" disabled="@(_busy || string.IsNullOrEmpty(_verzeBeta))"
            title="Beta se osvědčila → stane se stable. Dosavadní stable tím spadne do archivu.">
        ▲ Povýšit betu na stable
    </button>
</div>
@if (_verzeMsg is not null) { <div class="banner @(_verzeBad ? "bad" : "ok")">@_verzeMsg</div> }

<h3>Automatický rozvoz bety</h3>
<p class="muted">Pojistka pro tlačítko výše: když se obsah beta kanálu na serveru změní
    (<span class="mono">Set-AgentVersion.cmd</span>) a nikdo neklikne „Rozvézt betu na vzorek" ručně,
    udělá to tahle kontrola sama – v uvedeném intervalu, a jen pokud jde skutečně o jiný commit než posledně.</p>
<dl class="cfg">
    <dt>Zapnuto</dt>
    <dd>
        @if (_betaAutoEnabled) { <span class="pill ok">ZAPNUTO</span> } else { <span class="pill off">vypnuto</span> }
        &nbsp;<button class="btn" @onclick="ToggleBetaAuto" disabled="@_busy">@(_betaAutoEnabled ? "Vypnout" : "Zapnout")</button>
    </dd>
    <dt>Interval (min)</dt>
    <dd><input class="inp" style="min-width:90px" @bind="_betaAutoInterval" /></dd>
    <dt>Poslední (auto) běh</dt>
    <dd class="mono">@(string.IsNullOrEmpty(_betaAutoLastRun) ? "—" : _betaAutoLastRun)</dd>
</dl>
<div class="toolbar">
    <button class="btn" @onclick="SaveBetaAuto" disabled="@_busy">Uložit interval</button>
</div>
@if (_betaAutoMsg is not null) { <div class="banner @(_betaAutoBad ? "bad" : "ok")">@_betaAutoMsg</div> }

<h2>Auto-enrollment agenta</h2>
<p class="muted">Konzole sama nasadí agenta na stanice z AD <strong>bez agenta</strong> (24/7). Default <strong>VYPNUTO + dry-run</strong>.
    Ostrý běh vyžaduje, aby <strong>účet konzole měl lokální admin na klientech</strong> (dedikovaný deploy účet) — viz HANDOFF.</p>
<dl class="cfg">
    <dt>Zapnuto (master)</dt>
    <dd>
        @if (_deployEnabled) { <span class="pill bad">ZAPNUTO</span> } else { <span class="pill warn">vypnuto</span> }
        &nbsp;<button class="btn" @onclick="ToggleDeploy" disabled="@_busy">@(_deployEnabled ? "Vypnout" : "Zapnout")</button>
    </dd>
    <dt>Jen dry-run (report, nic nemění)</dt><dd><input type="checkbox" @bind="_deployDryRun" /></dd>
    <dt>Nové stanice – výchozí</dt>
    <dd>
        @if (_deployDefaultEnroll) { <span class="pill ok">nasazovat</span> } else { <span class="pill warn">nenasazovat</span> }
        &nbsp;<button class="btn" @onclick="ToggleDefaultEnroll" disabled="@_busy">@(_deployDefaultEnroll ? "Přepnout na nenasazovat" : "Přepnout na nasazovat")</button>
        <span class="muted">&nbsp;výchozí pro nově objevené PC; výjimky se dělají v <a href="stanice">Stanicích</a></span>
    </dd>
    <dt>Interval (min)</dt><dd><input class="inp" style="min-width:90px" @bind="_deployInterval" /></dd>
    <dt>Max stanic / běh</dt><dd><input class="inp" style="min-width:90px" @bind="_deployMaxPerRun" /></dd>
    <dt>Allowlist hostů (čárkou; prázdné = vše bez agenta)</dt><dd><input class="inp" @bind="_deployAllow" placeholder="PC01, PC02 …" /></dd>
    <dt>Vyřazené stanice</dt><dd class="muted">jednotlivé stanice vyřaď z nasazování přímo v <a href="stanice">Stanicích</a> (sloupec „Nasazení")</dd>
    <dt>Targets file (čte scheduled task pod deploy účtem)</dt><dd><input class="inp" @bind="_deployTargets" placeholder="C:\Apps\USBGuardianConsole\deploy-targets.txt" /></dd>
    <dt>Poslední běh</dt><dd class="mono">@(string.IsNullOrEmpty(_deployLastRun) ? "—" : _deployLastRun)</dd>
</dl>
<div class="toolbar">
    <button class="btn" @onclick="SaveDeploy" disabled="@_busy">Uložit nastavení deploye</button>
</div>
@if (_deployMsg is not null) { <div class="banner @(_deployBad ? "bad" : "ok")">@_deployMsg</div> }

<h2>Přístup do konzole</h2>
<p class="muted">Bootstrap z <code>appsettings.local.json</code> (nelze vyřadit — ochrana proti lockoutu)
+ DB seznam spravovaný zde. Pro tiché SSO choď přes hostname, ne IP.</p>
<dl class="cfg">
    <dt>Bootstrap skupiny</dt><dd>@Join("Authorization:AdminGroups")</dd>
    <dt>Bootstrap uživatelé</dt><dd>@Join("Authorization:AllowedUsers")</dd>
</dl>

<h3>Povolení uživatelé (DB)</h3>
<div class="toolbar">
    <input class="inp mono" @bind="_newUser" placeholder="DOMENA\uzivatel" />
    <button class="btn" @onclick="AddUser" disabled="@_busy">Přidat</button>
</div>
<ul class="linklist">
    @foreach (var u in _users)
    {
        <li><span class="mono">@u</span> <button class="iconbtn" @onclick="() => RemoveUser(u)" title="Odebrat">✕</button></li>
    }
    @if (_users.Count == 0) { <li class="muted">— žádní —</li> }
</ul>

<h3>Povolené skupiny (DB)</h3>
<div class="toolbar">
    <input class="inp mono" @bind="_newGroup" placeholder="DOMENA\skupina" />
    <button class="btn" @onclick="AddGroup" disabled="@_busy">Přidat</button>
</div>
<ul class="linklist">
    @foreach (var g in _groups)
    {
        <li><span class="mono">@g</span> <button class="iconbtn" @onclick="() => RemoveGroup(g)" title="Odebrat">✕</button></li>
    }
    @if (_groups.Count == 0) { <li class="muted">— žádné —</li> }
</ul>

<h2>E-mailové notifikace</h2>
<p class="muted">SMTP relay (např. M365 Direct Send: MX firmy, port 25, bez přihlášení). Vše v configu — portabilní.</p>
<dl class="cfg">
    <dt>Zapnuto</dt><dd><input type="checkbox" @bind="_emailEnabled" /></dd>
    <dt>SMTP host (relay / MX)</dt><dd><input class="inp" @bind="_emailHost" placeholder="firma-cz.mail.protection.outlook.com" /></dd>
    <dt>Port</dt><dd><input class="inp" style="min-width:90px" @bind="_emailPort" /></dd>
    <dt>STARTTLS</dt><dd><input type="checkbox" @bind="_emailStarttls" /></dd>
    <dt>Odesílatel (From)</dt><dd><input class="inp" @bind="_emailFrom" placeholder="robot@firma.cz" /></dd>
    <dt>Příjemci (čárkou)</dt><dd><input class="inp" @bind="_emailRecipients" placeholder="it@firma.cz, admin@firma.cz" /></dd>
    <dt>Interval alertů (min)</dt><dd><input class="inp" style="min-width:90px" @bind="_emailInterval" /></dd>
</dl>
<p class="muted">Alert posílá souhrn NOVÝCH neschválených incidentů (blok/varování) v daném intervalu;
při prvním zapnutí se nastaví baseline (historie se neposílá).</p>
<div class="toolbar">
    <button class="btn" @onclick="SaveEmail" disabled="@_busy">Uložit e-mail</button>
    <button class="btn" @onclick="TestEmail" disabled="@_busy">Poslat test</button>
</div>
@if (_emailMsg is not null) { <div class="banner @(_emailBad ? "bad" : "ok")">@_emailMsg</div> }
<p class="muted">Pozn.: nastavení + test odeslání. Spouštění notifikací nad incidenty (alert při blokaci /
denní souhrn) je další krok.</p>

<h2>AD sync</h2>
<dl class="cfg">
    <dt>Zapnuto</dt><dd>@(Config.GetValue<bool>("AdSync:Enabled") ? "ano" : "ne")</dd>
    <dt>Interval (min)</dt><dd>@(Config["AdSync:IntervalMinutes"] ?? "60")</dd>
    <dt>SearchBase (OU)</dt><dd>@(string.IsNullOrWhiteSpace(Config["AdSync:SearchBase"]) ? "(celá doména)" : Config["AdSync:SearchBase"])</dd>
</dl>

<h2>Retence dat (DB)</h2>
<p class="muted">Automatické mazání starých incidentů z databáze (NIS2 – minimalizace dat). Nastavení se ukládá
    centrálně; samotný úklid provádí <strong>API</strong> (má jako jediné práva mazat z <code>Incidents</code>),
    typicky 1× denně. Doporučení: 365 dní.</p>
<dl class="cfg">
    <dt>Zapnuto</dt>
    <dd>
        @if (_retentionEnabled) { <span class="pill bad">ZAPNUTO — mazat starší než limit</span> }
        else                    { <span class="pill warn">vypnuto — nic se nemaže</span> }
        &nbsp;<button class="btn" @onclick="ToggleRetention" disabled="@_busy">@(_retentionEnabled ? "Vypnout" : "Zapnout")</button>
    </dd>
    <dt>Uchovávat incidenty (dní)</dt><dd><input class="inp" style="min-width:90px" @bind="_retentionDays" /></dd>
    <dt>Poslední úklid</dt><dd class="mono">@(string.IsNullOrEmpty(_retentionLastRun) ? "—" : _retentionLastRun)</dd>
</dl>
<div class="toolbar">
    <button class="btn" @onclick="SaveRetention" disabled="@_busy">Uložit retenci</button>
</div>
@if (_retentionMsg is not null) { <div class="banner @(_retentionBad ? "bad" : "ok")">@_retentionMsg</div> }

<h2>Plánovaný restart služeb</h2>
<p class="muted">Denní restart hlídaných Windows služeb. <strong>Službu, která neběží, i nastartuje</strong> — to je
    pojistka proti výpadku typu „služba zůstala po deployi zastavená a nikdo si toho šest týdnů nevšiml“.
    Restart provádí <strong>účet služby konzole</strong>; na cizím serveru na to musí mít právo, jinak běh
    skončí hláškou „přístup odepřen“ (a je to vidět v <a href="kontroly">Kontrolách stavu</a>).</p>
<dl class="cfg">
    <dt>Zapnuto</dt>
    <dd>
        @if (_svcEnabled) { <span class="pill ok">ZAPNUTO</span> } else { <span class="pill off">vypnuto</span> }
        &nbsp;<button class="btn" @onclick="ToggleSvcRestart" disabled="@_busy">@(_svcEnabled ? "Vypnout" : "Zapnout")</button>
    </dd>
    <dt>Čas denního běhu (HH:mm)</dt>
    <dd><input class="inp" style="min-width:90px" @bind="_svcAt" placeholder="03:30" /></dd>
    <dt>Služby (řádek = <span class="mono">HOST|Název služby</span>)</dt>
    <dd>
        <textarea class="inp" style="min-width:520px;height:92px;font-family:var(--font-mono);font-size:12px"
                  @bind="_svcTargets" placeholder="SQL-SERVER|USB Guardian API"></textarea>
        <div class="muted">Host prázdný (jen název služby) = služba na tomto serveru. Řádek začínající <span class="mono">#</span> se ignoruje.</div>
    </dd>
    <dt>Poslední běh</dt><dd class="mono">@(string.IsNullOrEmpty(_svcLastRun) ? "—" : _svcLastRun)</dd>
</dl>
<div class="toolbar">
    <button class="btn" @onclick="SaveSvcRestart" disabled="@_busy">Uložit plán</button>
    <button class="btn" @onclick="RunSvcRestartNow" disabled="@_busy" title="Provede restart hned – ověření, že práva i názvy služeb sedí">▶ Restartovat teď</button>
</div>
@if (_svcMsg is not null) { <div class="banner @(_svcBad ? "bad" : "ok")">@_svcMsg</div> }

<h2>Kontroly stavu</h2>
<p class="muted">Parametry pro stránku <a href="kontroly">Kontroly</a> — ověření, že celý řetěz agent → API → DB → konzole opravdu funguje.</p>
<dl class="cfg">
    <dt>Adresa API pro agenty</dt>
    <dd>
        <input class="inp" @bind="_healthApiUrl" placeholder="https://SQL-SERVER:5443" />
        <div class="muted">Kontrola sem volá <span class="mono">/api/version</span>. Prázdné = dostupnost API se nekontroluje.</div>
    </dd>
    <dt>Incidenty smí být staré nejvýš (h)</dt>
    <dd>
        <input class="inp" style="min-width:90px" @bind="_healthMaxAge" />
        <div class="muted">Nad tímto stářím nejnovějšího incidentu se hlásí chyba (tichý výpadek sběru). Default 48.</div>
    </dd>
    <dt>Prodleva mezi kontrolami (ms)</dt>
    <dd>
        <input class="inp" style="min-width:90px" @bind="_healthStepDelay" />
        <div class="muted">Kvůli čitelnosti: kontroly jsou hotové za pár milisekund a běh by problikl —
            co problikne, není vidět. Prodleva dá každému kroku čas se odškrtnout před očima.
            Platí jen pro stránku; strojové <span class="mono">/api/health</span> běží naplno.
            0 = bez prodlevy, strop 2000. Default 300 (celý běh ≈ 4,5 s).</div>
    </dd>
</dl>
<div class="toolbar">
    <button class="btn" @onclick="SaveHealth" disabled="@_busy">Uložit kontroly</button>
</div>
@if (_healthMsg is not null) { <div class="banner @(_healthBad ? "bad" : "ok")">@_healthMsg</div> }

<h2>Údržba</h2>
<dl class="cfg">
    <dt>Aktualizovat nastavení</dt>
    <dd>
        <button class="btn" @onclick="ReloadSettings" disabled="@_busy">↻ Načíst z DB</button>
        @if (_reloadMsg is not null) { <span class="muted">&nbsp;@_reloadMsg</span> }
        <div class="muted">Znovu načte centrální nastavení a whitelist přístupů z DB (po ruční změně v databázi) bez restartu.</div>
    </dd>
</dl>

<h2>Databáze / síť</h2>
<dl class="cfg">
    <dt>SQL Server</dt><dd class="mono">@_sqlServer</dd>
    <dt>Databáze</dt><dd class="mono">@_sqlDb</dd>
    <dt>Endpoint</dt><dd class="mono">@(Config["Kestrel:Endpoints:Http:Url"] ?? "—")</dd>
    <dt>Build</dt><dd class="mono">commit @AppInfo.Commit</dd>
</dl>

@code {
    private bool _enforce, _busy;
    private string? _dbError;
    private string _newUser = "", _newGroup = "";
    private List<string> _users = new(), _groups = new();
    private string _sqlServer = "—", _sqlDb = "—";

    private bool _emailEnabled, _emailStarttls = true, _emailBad;
    private string _emailHost = "", _emailPort = "25", _emailFrom = "", _emailRecipients = "", _emailInterval = "15";
    private string? _emailMsg;

    private string _silentAfter = "180";
    private string? _commMsg;

    private bool _deployEnabled, _deployDryRun = true, _deployDefaultEnroll = true, _deployBad;
    private string _deployInterval = "30", _deployMaxPerRun = "10",
                   _deployAllow = "", _deployTargets = "", _deployLastRun = "";
    private string? _deployMsg;

    private bool _retentionEnabled, _retentionBad;
    private string _retentionDays = "365", _retentionLastRun = "";
    private string? _retentionMsg;

    private bool _svcEnabled, _svcBad;
    private string _svcAt = "03:30", _svcTargets = "", _svcLastRun = "";
    private string? _svcMsg;

    private string _uiStyle = USBGuardian.Admin.Ui.UiStyleCache.DefaultStyle;
    private string _uiLayout = USBGuardian.Admin.Ui.UiStyleCache.DefaultLayout;
    private bool _uiBad;
    private string? _uiMsg;

    private string _verzeDir = "", _verzeStable = "", _verzeBeta = "", _verzeKeep = "10";
    private List<string> _verze = new();
    private string _betaHosts = "";
    private string? _verzeMsg, _verzeChyba;
    private bool _verzeBad;

    private bool _betaAutoEnabled;
    private string _betaAutoInterval = "30", _betaAutoLastRun = "";
    private string? _betaAutoMsg;
    private bool _betaAutoBad;

    private bool _healthBad;
    private string _healthApiUrl = "", _healthMaxAge = "48", _healthStepDelay = "300";
    private string? _healthMsg;

    private string? _reloadMsg;

    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        ParseConnection();
        await Load();
    }

    private async Task Load()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            _enforce = string.Equals(await Get(db, "policy.enforce"), "true", StringComparison.OrdinalIgnoreCase);
            _users   = SplitList(await Get(db, "access.users"));
