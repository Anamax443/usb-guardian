    // Archiv se cte z disku, ne z databaze: zdroj pravdy o tom, ktere balicky
    // opravdu existuji, je slozka. Zaznam v DB, ktery neodpovida disku, by lhal.
    private void NactiVerze()
    {
        _verze.Clear();
        _verzeChyba = null;
        try
        {
            if (!Directory.Exists(_verzeDir)) { _verzeChyba = "složka neexistuje: " + _verzeDir; return; }
            _verze = Directory.GetDirectories(_verzeDir)
                .Where(d => File.Exists(Path.Combine(d, "USBGuardian.exe")))
                .OrderByDescending(d => Directory.GetLastWriteTimeUtc(d))
                .Select(d => Path.GetFileName(d)!)
                .ToList();
        }
        catch (Exception ex) { _verzeChyba = ex.Message; }
    }

    // Vzorek stanic musi videt uloha, ktera rozvazi betu - ta do databaze nevidi.
    private void ZapisBetaHosts()
    {
        try
        {
            var dir = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.CommonApplicationData),
                                   "USBGuardian", "deploy");
            Directory.CreateDirectory(dir);
            var radky = (_betaHosts ?? "")
                .Split(new[] { '\n', '\r', ',', ';' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            File.WriteAllLines(Path.Combine(dir, "update-beta.txt"), radky);
        }
        catch { /* neuspech zapisu nesmi shodit ulozeni nastaveni - je videt v hlasce */ }
    }

