    private async Task SaveVerze()
    {
        _verzeMsg = null;
        if (!int.TryParse(_verzeKeep?.Trim(), out var keep) || keep < 2 || keep > 100)
        { _verzeMsg = "Počet archivovaných verzí musí být 2 až 100."; _verzeBad = true; return; }

        _busy = true;
        try
        {
            await using (var db = await DbFactory.CreateDbContextAsync())
            {
                await Set(db, "agent.versionsDir",     (_verzeDir ?? "").Trim());
                await Set(db, "agent.version.stable",  (_verzeStable ?? "").Trim());
                await Set(db, "agent.version.beta",    (_verzeBeta ?? "").Trim());
                await Set(db, "agent.keepVersions",    keep.ToString());
                await Set(db, "agent.betaHosts",       (_betaHosts ?? "").Trim());
            }

            ZapisBetaHosts();

            // Strop musi videt i davka, ktera archivuje - ta do databaze nevidi.
            var zapis = "";
            try
            {
                if (Directory.Exists(_verzeDir))
                    await File.WriteAllTextAsync(Path.Combine(_verzeDir, "keep.txt"), keep.ToString());
                else
                    zapis = " (keep.txt nezapsán – složka archivu neexistuje)";
            }
            catch (Exception ex) { zapis = " (keep.txt nezapsán: " + ex.Message + ")"; }

            NactiVerze();
            _verzeMsg = $"Uloženo — stable: {(string.IsNullOrEmpty(_verzeStable) ? "—" : _verzeStable)}, "
                      + $"beta: {(string.IsNullOrEmpty(_verzeBeta) ? "—" : _verzeBeta)}, archiv {keep}{zapis}. "
                      + "Přepnutí provede Set-AgentVersion.cmd na serveru.";
            _verzeBad = false;
        }
        catch (Exception ex) { _verzeMsg = "Chyba: " + ex.Message; _verzeBad = true; }
        finally { _busy = false; }
    }

    private async Task SaveHealth()
    {
        _healthMsg = null;
        if (!int.TryParse(_healthMaxAge?.Trim(), out var h) || h <= 0)
        { _healthMsg = "Stáří incidentů musí být kladné číslo hodin."; _healthBad = true; return; }

        if (!int.TryParse(_healthStepDelay?.Trim(), out var delay) || delay < 0 || delay > 2000)
        { _healthMsg = "Prodleva musí být 0 až 2000 ms."; _healthBad = true; return; }

        var url = (_healthApiUrl ?? "").Trim();
        if (url.Length > 0 && !Uri.TryCreate(url, UriKind.Absolute, out _))
        { _healthMsg = "Adresa API musí být plná URL včetně schématu, např. https://SQL-SERVER:5443."; _healthBad = true; return; }

        _busy = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await Set(db, "health.apiUrl", url);
            await Set(db, "health.maxIncidentAgeHours", h.ToString());
            await Set(db, "health.stepDelayMs", delay.ToString());
            _healthMaxAge = h.ToString();
            _healthStepDelay = delay.ToString();
            _healthMsg = "Uloženo."; _healthBad = false;
        }
        catch (Exception ex) { _healthMsg = "Chyba: " + ex.Message; _healthBad = true; }
        finally { _busy = false; }
    }

    private static async Task<string> Get(AppDbContext db, string key)
        => (await db.AppSettings.FirstOrDefaultAsync(s => s.Key == key))?.Value ?? "";

    private static async Task Set(AppDbContext db, string key, string value)
    {
        var s = await db.AppSettings.FirstOrDefaultAsync(x => x.Key == key);
        if (s is null) db.AppSettings.Add(new AppSetting { Key = key, Value = value });
        else s.Value = value;
        await db.SaveChangesAsync();
    }

    private static List<string> SplitList(string s) =>
        string.IsNullOrWhiteSpace(s) ? new()
        : s.Split(new[] { ',', ';', '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

    private string Join(string key)
    {
        var vals = Config.GetSection(key).Get<string[]>();
        return vals is { Length: > 0 } ? string.Join(", ", vals) : "—";
    }

    private void ParseConnection()
    {
        var cs = Config.GetConnectionString("DefaultConnection") ?? "";
        foreach (var part in cs.Split(';', StringSplitOptions.RemoveEmptyEntries))
        {
            var kv = part.Split('=', 2);
            if (kv.Length != 2) continue;
            var k = kv[0].Trim().ToLowerInvariant();
            if (k is "server" or "data source") _sqlServer = kv[1].Trim();
            if (k is "database" or "initial catalog") _sqlDb = kv[1].Trim();
        }
    }
