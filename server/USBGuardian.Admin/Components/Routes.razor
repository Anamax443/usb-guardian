<Router AppAssembly="@System.Reflection.Assembly.GetExecutingAssembly()">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.MainLayout)">
            <NotAuthorized>
                <div class="notauth">
                    <h1>Přístup odepřen</h1>
                    <p>Konzole je dostupná pouze členům AD skupiny <code>USB-Guardian-Admins</code>.</p>
                </div>
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(Layout.MainLayout)">
            <p>Stránka nenalezena.</p>
        </LayoutView>
    </NotFound>
</Router>
