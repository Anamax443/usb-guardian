<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>USBGuardian.Admin</RootNamespace>
    <AssemblyName>USBGuardian.Admin</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- SQL Server přístup přes EF Core (stejná verze jako API) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.0" />
    <!-- Windows Service hosting (native, jako agent i API) -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.0" />
    <!-- Windows Authentication (Kerberos/NTLM) -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="8.0.0" />
    <!-- AD sync (LDAP dotaz na počítače v doméně) -->
    <PackageReference Include="System.DirectoryServices" Version="8.0.0" />
    <!-- Ovládání Windows služeb (plánovaný restart hlídaných služeb) -->
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
    <!-- Render dokumentace (.md → tisknutelné HTML v konzoli) -->
    <PackageReference Include="Markdig" Version="0.37.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- REUSE: stejné zdrojové soubory EF modelů + DbContext jako API
         (slinkované = jeden zdroj pravdy, bez tahání obsahu/deps API projektu) -->
    <Compile Include="..\USBGuardian.Api\Models\DbModels.cs" Link="Shared\DbModels.cs" />
    <Compile Include="..\USBGuardian.Api\Data\AppDbContext.cs" Link="Shared\AppDbContext.cs" />
    <Compile Include="..\USBGuardian.Api\Data\ActivityLogger.cs" Link="Shared\ActivityLogger.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Dokumentace (.md) zabalená do buildu – renderuje se jako tisknutelné HTML v konzoli -->
  <ItemGroup>
    <None Include="..\..\README.md"            Link="docs\README.md"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\README.en.md"         Link="docs\README.en.md"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\HANDOFF.md"           Link="docs\HANDOFF.md"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\HANDOFF.en.md"        Link="docs\HANDOFF.en.md"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\docs\architecture.md" Link="docs\architecture.md"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\docs\architecture.en.md" Link="docs\architecture.en.md"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\docs\auto-deploy-setup.md" Link="docs\auto-deploy-setup.md"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\docs\auto-deploy-setup.en.md" Link="docs\auto-deploy-setup.en.md"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\docs\oponentura.md" Link="docs\oponentura.md"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\docs\oponentura.en.md" Link="docs\oponentura.en.md"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\docs\oponentura-komercni.md" Link="docs\oponentura-komercni.md"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\docs\oponentura-komercni.en.md" Link="docs\oponentura-komercni.en.md"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <!-- Grafické výstupy – statické soubory servírované z kořene konzole.
         Každý má v hlavičce přepínač CS/EN, takže se nebundlují dvě jazykové varianty. -->
    <None Include="..\..\docs\how-it-works.html" Link="wwwroot\how-it-works.html"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\docs\mind-map.html" Link="wwwroot\mind-map.html"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\docs\flowchart.html" Link="wwwroot\flowchart.html"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\docs\management-summary.html" Link="wwwroot\management-summary.html"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
  </ItemGroup>

  <!-- Spolehlivé zaražení git commitu do assembly (patička konzole = kontrola aktuálnosti nasazení).
       Generuje zdrojový soubor přepsaný JEN při změně commitu (WriteOnlyWhenDifferent) → vynutí recompile
       i kdyz se jinak nezmenil zadny .cs. Pred-stav (BeforeTargets CoreGenerateAssemblyInfo) drzel stary commit. -->
  <Target Name="StampGitCommit" BeforeTargets="CoreCompile">
    <Exec Command="git -C &quot;$(MSBuildProjectDirectory)&quot; rev-parse --short HEAD"
          ConsoleToMSBuild="true" ContinueOnError="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitHash" />
    </Exec>
    <PropertyGroup>
      <GitCommitHash Condition="'$(GitCommitHash)' == ''">dev</GitCommitHash>
      <_GitStampFile>$(IntermediateOutputPath)GitCommit.g.cs</_GitStampFile>
    </PropertyGroup>
    <ItemGroup>
      <_GitStampLines Include="// &lt;auto-generated/&gt;" />
      <_GitStampLines Include="[assembly: System.Reflection.AssemblyMetadata(&quot;GitCommit&quot;, &quot;$(GitCommitHash)&quot;)]" />
    </ItemGroup>
    <WriteLinesToFile File="$(_GitStampFile)" Lines="@(_GitStampLines)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_GitStampFile)" />
    </ItemGroup>
  </Target>

</Project>
