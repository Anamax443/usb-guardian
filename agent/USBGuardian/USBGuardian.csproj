<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>usb-guardian-agent</UserSecretsId>
    <RootNamespace>USBGuardian</RootNamespace>
    <AssemblyName>USBGuardian</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows Service hosting -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.0" />

    <!-- WMI pro detekci USB zařízení -->
    <PackageReference Include="System.Management" Version="8.0.0" />

    <!-- JSON konfigurace -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />

    <!-- Logování -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kopírovat config do output složky při každém buildu -->
    <None Update="Config\agent.config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Config\whitelist_public.pem">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Zaražení git commit hashe do assembly (agent hlásí jako verzi → konzole „Agent verze") -->
  <Target Name="StampGitCommit" BeforeTargets="CoreGenerateAssemblyInfo">
    <Exec Command="git -C &quot;$(MSBuildProjectDirectory)&quot; rev-parse --short HEAD"
          ConsoleToMSBuild="true" ContinueOnError="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitHash" />
    </Exec>
    <ItemGroup>
      <AssemblyMetadata Include="GitCommit" Value="$(GitCommitHash)" Condition="'$(GitCommitHash)' != ''" />
    </ItemGroup>
  </Target>

</Project>
