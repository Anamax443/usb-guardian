<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>usb-guardian-agent</UserSecretsId>
    <RootNamespace>USBGuardian</RootNamespace>
    <AssemblyName>USBGuardian</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows Service hosting -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.0" />

    <!-- WMI pro detekci USB zařízení -->
    <PackageReference Include="System.Management" Version="8.0.0" />

    <!-- JSON konfigurace -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />

    <!-- Logování -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.0" />
    <!-- Služba pod SYSTEM nemá konzoli – bez Event Logu po sobě na stanici nenechá stopu -->
    <PackageReference Include="Microsoft.Extensions.Logging.EventLog" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kopírovat config do output složky při každém buildu -->
    <None Update="Config\agent.config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Config\whitelist_public.pem">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Spolehlivé zaražení git commitu (agent hlásí verzi → konzole „Agent verze"). Generuje zdrojový soubor
       přepsaný JEN při změně commitu → vynutí recompile i bez jiné změny .cs (jinak stary stamp). -->
  <Target Name="StampGitCommit" BeforeTargets="CoreCompile">
    <Exec Command="git -C &quot;$(MSBuildProjectDirectory)&quot; rev-parse --short HEAD"
          ConsoleToMSBuild="true" ContinueOnError="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitHash" />
    </Exec>
    <PropertyGroup>
      <GitCommitHash Condition="'$(GitCommitHash)' == ''">dev</GitCommitHash>
      <_GitStampFile>$(IntermediateOutputPath)GitCommit.g.cs</_GitStampFile>
    </PropertyGroup>
    <ItemGroup>
      <_GitStampLines Include="// &lt;auto-generated/&gt;" />
      <_GitStampLines Include="[assembly: System.Reflection.AssemblyMetadata(&quot;GitCommit&quot;, &quot;$(GitCommitHash)&quot;)]" />
    </ItemGroup>
    <WriteLinesToFile File="$(_GitStampFile)" Lines="@(_GitStampLines)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_GitStampFile)" />
    </ItemGroup>
  </Target>

</Project>
