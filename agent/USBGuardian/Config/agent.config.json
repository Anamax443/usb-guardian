{
  "policy": {
    "mode": "warn",
    "maxOfflineAgeDays": 30,
    "onExpiredWhitelist": "warn"
  },
  "whitelist": {
    "localPath": "C:\\ProgramData\\USBGuardian\\whitelist\\whitelist.json",
    "syncUrl": "http://YOUR_API_SERVER:5050",
    "syncIntervalMinutes": 15,
    "allowWildcards": false,
    "signatureVerification": false
  },
  "sync": {
    "incidentSyncIntervalMinutes": 1,
    "whitelistSyncIntervalMinutes": 15
  },
  "notifications": {
    "toast": {
      "enabled": true,
      "contactMessage": "Kontaktujte IT oddeleni"
    },
    "email": {
      "enabled": false,
      "provider": "microsoft_graph",
      "graph": {
        "tenantId": "",
        "clientId": "",
        "clientSecret": "",
        "senderAddress": ""
      },
      "recipients": {
        "immediate": [],
        "digest": []
      },
      "immediateAlertOn": [ "block", "warn" ],
      "digestSchedule": "daily",
      "digestTime": "08:00"
    }
  },
  "logging": {
    "queuePath":          "C:\\ProgramData\\USBGuardian\\queue",
    "sentPath":           "C:\\ProgramData\\USBGuardian\\sent",
    "sentRetentionDays":  90,
    "logLevel":           "Information"
  }
}
