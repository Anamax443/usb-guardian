{
  // ============================================================
  // agent.config.json – výchozí konfigurace agenta
  // Pro lokální přepisy vytvořte agent.config.local.json
  // (local soubor se NECOMMITUJE)
  // ============================================================

  "policy": {
    "mode": "warn",
    "maxOfflineAgeDays": 30,
    "onExpiredWhitelist": "warn"
  },

  "whitelist": {
    "localPath": "C:\\ProgramData\\USBGuardian\\whitelist\\whitelist.json",
    "syncUrl": "https://YOUR_API_SERVER:5443",
    "allowWildcards": false
  },

  // ── TLS konfigurace ─────────────────────────────────────────
  // validateServerCertificate: true  = agent ověří TLS certifikát (produkce)
  // validateServerCertificate: false = agent přijme jakýkoliv certifikát (vývoj)
  // Certifikát serveru musí být nainstalován v Trusted Root (Install-Certificate.ps1)
  // ── TLS konfigurace ─────────────────────────────────────────
  // pinnedThumbprint: otisk self-cert API (self-contained TLS bez CA).
  //   Když je vyplněn, agent ověří, že server předkládá přesně tento cert
  //   (šifrované + ověřená identita). Otisk získáš z logu API nebo /api/cert-info.
  // validateServerCertificate: použije se jen když pinnedThumbprint je prázdný
  //   (true = validace přes CA, false = bez ověření – jen vývoj).
  "tls": {
    "validateServerCertificate": true,
    "pinnedThumbprint": ""
  },

  // ── RSA podpis whitelistu ───────────────────────────────────
  "signing": {
    "enabled": true,
    "publicKeyPath": "Config\\whitelist_public.pem"
  },

  "sync": {
    "whitelistSyncIntervalMinutes": 15,
    "incidentSyncIntervalMinutes": 1
  },

  "logging": {
    "queuePath": "C:\\ProgramData\\USBGuardian\\queue",
    "sentPath": "C:\\ProgramData\\USBGuardian\\sent",
    "sentRetentionDays": 90,
    "logLevel": "Information"
  },

  "notifications": {
    "toast": {
      "enabled": true,
      "contactMessage": "Kontaktujte IT oddeleni"
    }
  },

  // ── Lokální admin konzole ───────────────────────────────────
  // enabled: false = výchozí (minimální attack surface, NIS2)
  // Naslouchá jen na 127.0.0.1, vyžaduje lokálního admina, read-only.
  // Pro vývoj/diagnostiku zapnout v agent.config.local.json.
  "localConsole": {
    "enabled": false,
    "port": 5080
  }
}
